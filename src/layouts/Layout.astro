---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
const rssHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  "rss.xml"
);

// E-E-A-T global: WebSite + Organization em todas as páginas
const siteBase = (Astro.site ?? new URL(site.url)).href
const orgId = `${siteBase}#organization`
const globalSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: "Dimus",
      url: site.profile || site.url,
      logo: {
        "@type": "ImageObject",
        "@id": `${siteBase}#logo`,
        url: new URL("logo-dimus.png", siteBase).href,
        contentUrl: new URL("logo-dimus.png", siteBase).href,
        width: 512,
        height: 512,
      },
      sameAs: [
        "https://instagram.com/dimus",
        "https://www.linkedin.com/company/dimus/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteBase}#website`,
      url: siteBase,
      name: site.title,
      description: site.description,
      publisher: { "@id": orgId },
      inLanguage: site.lang,
    },
  ],
}

// Meta Pixel ID — dataset Dimus (BM_MotherShip). PÚBLICO (client-side, ok commitar).
// Só injeta em PRODUÇÃO (build) → dev local não polui o pixel real. Override por
// PUBLIC_META_PIXEL_ID. HTML montado no frontmatter + <Fragment set:html> p/ o
// esbuild não tentar compilar o snippet do pixel como módulo.
const metaPixelId = import.meta.env.PROD
  ? (import.meta.env.PUBLIC_META_PIXEL_ID ?? "998136448049534")
  : "";
const metaPixelHtml = metaPixelId
  ? `<script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${metaPixelId}');fbq('track','PageView');</script><noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1"/></noscript>`
  : "";
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  data-theme="dark"
  class="dark overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={getAssetPath("favicon.ico")} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="icon" type="image/png" href={getAssetPath("favicon.png")} sizes="32x32" />
    <link rel="apple-touch-icon" href={getAssetPath("apple-touch-icon.png")} />
    <link rel="canonical" href={canonicalURL} />
    {/* Remove generator tag — evita exposição de stack */}

    <!-- Fonts — Revista Showroom -->
    <Font
      cssVariable="--font-hanken-grotesk"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <Font
      cssVariable="--font-fraunces"
      preload={[{ subset: "latin", weight: 600, style: "normal" }]}
    />
    <Font cssVariable="--font-jetbrains-mono" />

    <!-- Google Analytics 4 — Dimus Blog (G-Y7PSFTCZJL) — property 543369220 conta [Ativo] Dimus -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-Y7PSFTCZJL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-Y7PSFTCZJL");
    </script>

    {/* Meta Pixel base — injeta só se PUBLIC_META_PIXEL_ID estiver setado. */}
    {metaPixelHtml && <Fragment set:html={metaPixelHtml} />}

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph — WhatsApp / Facebook / LinkedIn / Google preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:image:alt" content={title} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <meta name="theme-color" content="#c62184" />

    <!-- E-E-A-T global: Organization + WebSite -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(globalSchema)}
    />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!-- Bing Webmaster Tools verification -->
    <meta name="msvalidate.01" content="2413FE4B7E625C70A07086AE3EDBEF0B" />

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        // Revista Showroom é dark-only (design validado). Força dark sempre.
        const theme = "dark";
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", true);
        window.__theme = { value: theme };
      })();
    </script>

    <ClientRouter />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground"
    style="overflow-x:hidden"
  >
    <!-- Orb ambiente (profundidade, não decoração) -->
    <div class="orb" aria-hidden="true"></div>

    <!-- Leitura progress bar (atualizado por showroom-motion.js) -->
    <div class="sr-progress" id="sr-progress" aria-hidden="true"></div>

    <!-- Shell: rail (esquerda sticky) + main (conteúdo) -->
    <div class="sr-shell">
      <!-- ── Rail ── -->
      <aside class="sr-rail" aria-label="Navegação do blog">
        <a href="/" class="sr-brand">
          <div class="mark" aria-hidden="true">
            <img src="/dimus-symbol.png" alt="" width="22" height="22" style="width:22px;height:22px;object-fit:contain;filter:brightness(0) invert(1)" />
          </div>
          <span class="name">Blog Dimus</span>
        </a>

        <nav aria-label="Clusters editoriais">
          <p class="sr-rail-label" style="margin-bottom:10px">Clusters</p>
          <ul class="sr-clusters" id="sr-clusters">
            <li><a href="/tags/giro-de-estoque"><span>Giro de Estoque</span><span class="ct">→</span></a></li>
            <li><a href="/tags/seminovos"><span>Seminovos</span><span class="ct">→</span></a></li>
            <li><a href="/tags/gestao"><span>Gestão</span><span class="ct">→</span></a></li>
            <li><a href="/tags/aquisicao"><span>Aquisição</span><span class="ct">→</span></a></li>
            <li><a href="/tags/atribuicao"><span>Atribuição</span><span class="ct">→</span></a></li>
            <li><a href="/tags/metricas"><span>Métricas</span><span class="ct">→</span></a></li>
            <li><a href="/posts"><span>Todos os posts</span><span class="ct">→</span></a></li>
          </ul>
        </nav>

        <!-- Newsletter widget no rail -->
        <div class="sr-rail-bottom">
          <h4>Sem enrolação, toda semana</h4>
          <p>Marketing que mede carro vendido. Sem portal, sem CRM, sem bullshit.</p>
          <form id="rail-nl-form" onsubmit="submitRailNewsletter(event)">
            <div class="sr-field">
              <input type="text" name="nome" placeholder="Seu nome" autocomplete="given-name" required />
            </div>
            <div class="sr-field">
              <input type="email" name="email" placeholder="Seu e-mail" autocomplete="email" required />
              <button type="submit" class="sr-btn-mini" aria-label="Inscrever">→</button>
            </div>
            <p id="rail-nl-msg" style="font-size:11.5px;color:var(--magenta);display:none;margin:4px 0 0;font-family:var(--font-mono)">
              ✓ Inscrito!
            </p>
          </form>
        </div>
      </aside>

      <!-- ── Main ── -->
      <div class="sr-main">
        <slot />
      </div>
    </div>

    <script>
      import "@/scripts/theme";
    </script>

    <!-- Showroom motion: progress bar, reveals, TOC scroll-spy -->
    <script>
      import gsap from "gsap";
      import ScrollTrigger from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);

      function initShowroom() {
        // Kill stale triggers from previous page
        ScrollTrigger.getAll().forEach(t => t.kill());

        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // ── Reading progress bar ─────────────────────────────────
        const prog = document.getElementById("sr-progress");
        if (prog) {
          const upd = () => {
            const h = document.documentElement;
            const max = h.scrollHeight - h.clientHeight;
            prog.style.width = (max > 0 ? (scrollY / max * 100) : 0) + "%";
          };
          addEventListener("scroll", upd, { passive: true });
          upd();
        }

        // ── Active rail link ─────────────────────────────────────
        document.querySelectorAll("#sr-clusters a").forEach(a => {
          a.removeAttribute("data-active");
          if (location.pathname.startsWith((a as HTMLAnchorElement).getAttribute("href") || "___")) {
            a.setAttribute("data-active", "");
          }
        });

        // ── Card reveal on scroll ────────────────────────────────
        // DESIGN RULE: stagger é por coluna dentro da linha (3-col grid).
        // Cartas in-viewport revelam imediatamente com micro-stagger.
        // Cartas abaixo do fold revelam quando entram na tela via ScrollTrigger.
        if (!reduce) {
          const COLS = 3;
          const reveals = [...document.querySelectorAll(".sr-reveal")];
          reveals.forEach((el, i) => {
            const rect = (el as HTMLElement).getBoundingClientRect();
            const inView = rect.top < window.innerHeight * 0.95;
            const colDelay = (i % COLS) * 0.09; // stagger por coluna
            if (inView) {
              gsap.to(el, {
                opacity: 1,
                y: 0,
                duration: 0.6,
                delay: colDelay,
                ease: "power3.out",
              });
              (el as HTMLElement).classList.add("sr-visible");
            } else {
              // Cria um "snapshot" de i para o closure
              const col = i % COLS;
              ScrollTrigger.create({
                trigger: el,
                start: "top 92%",
                onEnter: () => {
                  gsap.to(el, {
                    opacity: 1,
                    y: 0,
                    duration: 0.65,
                    delay: col * 0.09,
                    ease: "power3.out",
                    overwrite: "auto",
                  });
                  (el as HTMLElement).classList.add("sr-visible");
                },
                once: true,
              });
            }
          });

          // ── Cover parallax (post view) ───────────────────────
          const coverImg = document.querySelector(".sr-post-cover img") as HTMLElement;
          if (coverImg) {
            gsap.to(coverImg, {
              yPercent: 16,
              ease: "none",
              scrollTrigger: {
                trigger: ".sr-post-cover",
                start: "top top",
                end: "bottom top",
                scrub: true,
              },
            });
          }

          // ── TOC scroll-spy ───────────────────────────────────
          const heads = [...document.querySelectorAll(".sr-prose h2")];
          const tocLinks = [...document.querySelectorAll(".sr-toc a")];
          if (heads.length && tocLinks.length) {
            heads.forEach((h, idx) => {
              ScrollTrigger.create({
                trigger: h,
                start: "top 30%",
                end: "bottom 30%",
                onToggle: s => {
                  if (s.isActive) {
                    tocLinks.forEach(l => l.classList.remove("active"));
                    if (tocLinks[idx]) tocLinks[idx].classList.add("active");
                  }
                },
              });
            });
            tocLinks.forEach((a, idx) => {
              a.addEventListener("click", e => {
                e.preventDefault();
                heads[idx]?.scrollIntoView({ behavior: "smooth", block: "start" });
              });
            });
          }
        }

        // ── Rail newsletter ──────────────────────────────────────
        (window as any).submitRailNewsletter = async function(e: Event) {
          e.preventDefault();
          const form = e.target as HTMLFormElement;
          const nome = (form.elements.namedItem("nome") as HTMLInputElement).value.trim();
          const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
          const btn = form.querySelector("button") as HTMLButtonElement;
          if (btn) btn.disabled = true;
          try {
            const resp = await fetch("/newsletter", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ nome, email }),
            });
            const result = await resp.json().catch(() => ({}));
            // GA4 (estudo de tracking wf_f26e1b8f-44a) -- achado ao vivo
            // 2026-07-15: este é o form REAL renderizado (rail-nl-form), não
            // o componente NewsletterForm.astro (nunca importado em lugar
            // nenhum -- código morto). generate_lead nunca disparava aqui.
            if (resp.ok && (result as any).ok) {
              const gtag = (window as any).gtag;
              if (gtag) gtag("event", "generate_lead", { lead_source: "blog", lead_type: "newsletter" });
            }
          } catch {}
          form.reset();
          const msg = document.getElementById("rail-nl-msg");
          if (msg) msg.style.display = "block";
        };
      }

      // Run on initial load and after every ViewTransition navigation.
      // DOMContentLoaded covers direct URL visits (astro:page-load fires too late for SSG).
      document.addEventListener("astro:page-load", initShowroom);
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initShowroom, { once: true });
      } else {
        initShowroom();
      }
    </script>
  </body>
</html>
