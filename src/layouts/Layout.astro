---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import { getWhatsAppUrl } from "@/utils/getWhatsAppUrl";
import "@/styles/global.css";

const whatsAppUrl = getWhatsAppUrl(config);

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogType = "website",
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
const rssHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  "rss.xml"
);

// E-E-A-T global: WebSite + Organization em todas as páginas
const siteBase = (Astro.site ?? new URL(site.url)).href
const orgId = `${siteBase}#organization`
const orgName = site.organization?.name ?? site.author
const orgLogo = site.organization?.logo ?? "logo.png"
const orgSameAs = site.organization?.sameAs ?? []
const globalSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: orgName,
      url: site.profile || site.url,
      logo: {
        "@type": "ImageObject",
        "@id": `${siteBase}#logo`,
        url: new URL(orgLogo, siteBase).href,
        contentUrl: new URL(orgLogo, siteBase).href,
        width: 512,
        height: 512,
      },
      ...(orgSameAs.length && { sameAs: orgSameAs }),
    },
    {
      "@type": "WebSite",
      "@id": `${siteBase}#website`,
      url: siteBase,
      name: site.title,
      description: site.description,
      publisher: { "@id": orgId },
      inLanguage: site.lang,
    },
  ],
}

// Meta Pixel — env PUBLIC_META_PIXEL_ID tem prioridade; fallback em config.site.metaPixelId
const metaPixelId = import.meta.env.PROD
  ? (import.meta.env.PUBLIC_META_PIXEL_ID ?? site.metaPixelId ?? "")
  : "";
const metaPixelHtml = metaPixelId
  ? `<script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${metaPixelId}');fbq('track','PageView');window.__fbpid='${metaPixelId}';</script><noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1"/></noscript>`
  : "";
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  data-theme="dark"
  class="dark overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="-oEQ5PHjTYRgo6RDLGStkCFD-euvac18kLxswbSRTHE" />
    <link rel="icon" href={getAssetPath("favicon.ico")} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="icon" type="image/png" href={getAssetPath("favicon-48.png")} sizes="48x48" />
    <link rel="icon" type="image/png" href={getAssetPath("favicon-192.png")} sizes="192x192" />
    <link rel="apple-touch-icon" href={getAssetPath("apple-touch-icon.png")} />
    <link rel="canonical" href={canonicalURL} />
    {/* Remove generator tag — evita exposição de stack */}

    <!-- Fonts — Plus Jakarta Sans (display/app) + IBM Plex Sans (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
    <Font cssVariable="--font-jetbrains-mono" />

    <!-- Google Analytics 4 — ID em config.site.ga4Id -->
    {site.ga4Id && (
      <Fragment set:html={`<script async src="https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${site.ga4Id}');</script>`} />
    )}

    {/* Meta Pixel base — injeta só se PUBLIC_META_PIXEL_ID estiver setado. */}
    {metaPixelHtml && <Fragment set:html={metaPixelHtml} />}

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph — WhatsApp / Facebook / LinkedIn / Google preview -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:image:alt" content={title} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <meta name="theme-color" content="#c62184" />

    <!-- E-E-A-T global: Organization + WebSite -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(globalSchema)}
    />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!-- Bing Webmaster Tools verification -->
    <meta name="msvalidate.01" content="2413FE4B7E625C70A07086AE3EDBEF0B" />

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        // Revista Showroom é dark-only (design validado). Força dark sempre.
        const theme = "dark";
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", true);
        window.__theme = { value: theme };
      })();
    </script>

    <ClientRouter />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground"
    style="overflow-x:hidden"
  >
    <!-- Reading progress bar -->
    <div class="sr-progress" id="sr-progress" aria-hidden="true"></div>

    <!-- Top navbar -->
    <nav class="site-nav" id="site-nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo" aria-label="Alínea Finanças — Blog">
          <img src="/logo-alinea.png" alt="Alínea Finanças" height="28" style="height:28px;width:auto;opacity:.92" />
        </a>
        <ul class="nav-links" role="list">
          <li><a href="/posts" class="nav-a">Posts</a></li>
          <li><a href="/tags" class="nav-a">Tags</a></li>
          <li><a href="/about" class="nav-a">Sobre</a></li>
        </ul>
        <div class="nav-right">
          <a href="/search" class="nav-search-btn" aria-label="Buscar artigos">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <span>Buscar</span>
          </a>
          <a href={whatsAppUrl} target="_blank" rel="noopener" class="nav-cta">
            Falar com especialista
          </a>
        </div>
      </div>
    </nav>

    <!-- Page content -->
    <slot />

    <script>
      import "@/scripts/theme";
    </script>

    <!-- Showroom motion: progress bar, reveals, TOC scroll-spy -->
    <script>
      import gsap from "gsap";
      import ScrollTrigger from "gsap/ScrollTrigger";
      import SplitText from "gsap/SplitText";
      gsap.registerPlugin(ScrollTrigger, SplitText);

      let _splits: any[] = [];

      function initShowroom() {
        // Kill stale triggers from previous page
        ScrollTrigger.getAll().forEach(t => t.kill());
        // Revert stale SplitText DOM mutations (ViewTransition cleanup)
        _splits.forEach(s => { try { s.revert(); } catch { /* noop */ } });
        _splits = [];

        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // ── Reading progress bar ─────────────────────────────────
        const prog = document.getElementById("sr-progress");
        if (prog) {
          const upd = () => {
            const h = document.documentElement;
            const max = h.scrollHeight - h.clientHeight;
            prog.style.width = (max > 0 ? (scrollY / max * 100) : 0) + "%";
          };
          addEventListener("scroll", upd, { passive: true });
          upd();
        }

        // ── Active rail link ─────────────────────────────────────
        document.querySelectorAll("#sr-clusters a").forEach(a => {
          a.removeAttribute("data-active");
          if (location.pathname.startsWith((a as HTMLAnchorElement).getAttribute("href") || "___")) {
            a.setAttribute("data-active", "");
          }
        });

        // ── Card reveal on scroll ────────────────────────────────
        // DESIGN RULE: stagger é por coluna dentro da linha (3-col grid).
        // Cartas in-viewport revelam imediatamente com micro-stagger.
        // Cartas abaixo do fold revelam quando entram na tela via ScrollTrigger.
        if (!reduce) {
          const COLS = 3;
          const reveals = [...document.querySelectorAll(".sr-reveal")];
          reveals.forEach((el, i) => {
            const rect = (el as HTMLElement).getBoundingClientRect();
            const inView = rect.top < window.innerHeight * 0.95;
            const colDelay = (i % COLS) * 0.09; // stagger por coluna
            if (inView) {
              gsap.to(el, {
                opacity: 1,
                y: 0,
                duration: 0.6,
                delay: colDelay,
                ease: "power3.out",
              });
              (el as HTMLElement).classList.add("sr-visible");
            } else {
              // Cria um "snapshot" de i para o closure
              const col = i % COLS;
              ScrollTrigger.create({
                trigger: el,
                start: "top 92%",
                onEnter: () => {
                  gsap.to(el, {
                    opacity: 1,
                    y: 0,
                    duration: 0.65,
                    delay: col * 0.09,
                    ease: "power3.out",
                    overwrite: "auto",
                  });
                  (el as HTMLElement).classList.add("sr-visible");
                },
                once: true,
              });
            }
          });

          // ── Cover parallax (post view) ───────────────────────
          const coverImg = document.querySelector(".sr-post-cover img") as HTMLElement;
          if (coverImg) {
            gsap.to(coverImg, {
              yPercent: 16,
              ease: "none",
              scrollTrigger: {
                trigger: ".sr-post-cover",
                start: "top top",
                end: "bottom top",
                scrub: true,
              },
            });
          }

          // ── TOC scroll-spy ───────────────────────────────────
          const heads = [...document.querySelectorAll(".sr-prose h2")];
          const tocLinks = [...document.querySelectorAll(".sr-toc a")];
          if (heads.length && tocLinks.length) {
            heads.forEach((h, idx) => {
              ScrollTrigger.create({
                trigger: h,
                start: "top 30%",
                end: "bottom 30%",
                onToggle: s => {
                  if (s.isActive) {
                    tocLinks.forEach(l => l.classList.remove("active"));
                    if (tocLinks[idx]) tocLinks[idx].classList.add("active");
                  }
                },
              });
            });
            tocLinks.forEach((a, idx) => {
              a.addEventListener("click", e => {
                e.preventDefault();
                heads[idx]?.scrollIntoView({ behavior: "smooth", block: "start" });
              });
            });
          }

          // ── Eyebrow + brand-sub entrance (home) ─────────────────
          const eyebrow = document.querySelector<HTMLElement>(".sr-eyebrow:first-of-type");
          const brandSub = document.querySelector<HTMLElement>(".sr-brand-sub");
          const headerEls = [eyebrow, brandSub].filter(Boolean) as HTMLElement[];
          if (headerEls.length) {
            gsap.from(headerEls, {
              y: 14,
              opacity: 0,
              duration: 0.55,
              stagger: 0.12,
              ease: "power2.out",
            });
          }

          // ── SplitText: post h1 word-by-word reveal ───────────────
          const postH1 = document.querySelector<HTMLElement>(".sr-post-h1");
          if (postH1) {
            postH1.classList.add("sr-visible"); // cancel CSS fallback
            gsap.set(postH1, { opacity: 1, y: 0 });
            const split = new SplitText(postH1, { type: "words" });
            _splits.push(split);
            gsap.from(split.words, {
              y: 20,
              opacity: 0,
              duration: 0.6,
              stagger: 0.04,
              ease: "power3.out",
              onComplete() { split.revert(); },
            });
          }

          // ── CutoutCard hover lift ────────────────────────────────
          document.querySelectorAll<HTMLElement>(".sr-cutcard").forEach(card => {
            card.addEventListener("mouseenter", () =>
              gsap.to(card, { y: -4, duration: 0.2, ease: "power2.out", overwrite: "auto" })
            );
            card.addEventListener("mouseleave", () =>
              gsap.to(card, { y: 0, duration: 0.3, ease: "power2.inOut", overwrite: "auto" })
            );
          });
        }

        // ── Rail newsletter ──────────────────────────────────────
        (window as any).submitRailNewsletter = async function(e: Event) {
          e.preventDefault();
          const form = e.target as HTMLFormElement;
          const nome = (form.elements.namedItem("nome") as HTMLInputElement).value.trim();
          const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
          const btn = form.querySelector("button") as HTMLButtonElement;
          if (btn) btn.disabled = true;
          try {
            const resp = await fetch("/newsletter", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ nome, email }),
            });
            const result = await resp.json().catch(() => ({}));
            if (resp.ok && (result as any).ok) {
              // Ref único para dedup pixel ↔ CAPI (mesmo padrão de lead.ts)
              let ref = "nl-" + Date.now().toString(36);
              try {
                const a = new Uint8Array(3);
                crypto.getRandomValues(a);
                ref += "-" + Array.from(a, b => b.toString(36)).join("").slice(0, 5);
              } catch { /* noop */ }

              // GA4 — recommended event (funil) + evento específico p/ Google Ads import
              const gtag = (window as any).gtag;
              if (gtag) {
                gtag("event", "generate_lead", { lead_source: "blog", lead_type: "newsletter", lead_ref: ref });
                gtag("event", "blog_newsletter_signup", { lead_source: "blog", lead_ref: ref });
              }

              // Meta Pixel — Advanced Matching (email hashed) + Lead event
              const fbq = (window as any).fbq;
              const pid = (window as any).__fbpid;
              if (fbq && pid) {
                try {
                  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(email.toLowerCase().trim()));
                  const em = Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, "0")).join("");
                  fbq("init", pid, { em });
                } catch { /* noop — Advanced Matching opcional */ }
                fbq("track", "Lead", { content_name: "blog-newsletter" }, { eventID: ref });
              }
            }
          } catch {}
          form.reset();
          const msg = document.getElementById("rail-nl-msg");
          if (msg) msg.style.display = "block";
        };
      }

      // Run on initial load and after every ViewTransition navigation.
      // DOMContentLoaded covers direct URL visits (astro:page-load fires too late for SSG).
      document.addEventListener("astro:page-load", initShowroom);
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initShowroom, { once: true });
      } else {
        initShowroom();
      }
    </script>

    <!-- GA4 World-Class Events + Meta Pixel Contact — scroll_depth · time_on_page · article_read · outbound_click · whatsapp_click · share_click · search -->
    <script is:inline define:vars={{ ga4Id: site.ga4Id, pixelId: site.metaPixelId ?? "" }}>
      if (ga4Id) (function () {
        var cleanups = [];

        function fire(name, params) {
          if (typeof window.gtag === "function")
            window.gtag("event", name, Object.assign({ send_to: ga4Id }, params));
        }

        function teardown() { cleanups.forEach(function (fn) { fn(); }); cleanups = []; }

        function init() {
          teardown();
          var path = location.pathname;
          var isArt = /^\/posts\/[^\/]+/.test(path);
          var ptype = isArt ? "article" : "other";
          var slug = isArt ? ((path.match(/\/posts\/([^\/]+)/) || [])[1] || "") : "";

          /* 1 — Scroll depth 25 / 50 / 75 / 100 % */
          var milestones = [25, 50, 75, 100], hit = {};
          function onScroll() {
            var h = document.documentElement;
            var max = h.scrollHeight - h.clientHeight;
            if (max <= 0) return;
            var pct = Math.round(window.scrollY / max * 100);
            milestones.forEach(function (m) {
              if (pct >= m && !hit[m]) { hit[m] = true; fire("scroll_depth", { percent_scrolled: m, page_type: ptype }); }
            });
          }
          window.addEventListener("scroll", onScroll, { passive: true });
          cleanups.push(function () { window.removeEventListener("scroll", onScroll); });

          /* 2 — Time on page heartbeat every 60 s */
          var elapsed = 0;
          var tTimer = setInterval(function () {
            elapsed += 60; fire("time_on_page", { seconds: elapsed, page_type: ptype });
          }, 60000);
          cleanups.push(function () { clearInterval(tTimer); });

          /* 3 — Article read = 75 % scroll + 30 s dwell (articles only) */
          if (isArt) {
            var dwell = 0, past75 = false, didRead = false;
            var arKey = "ar_" + slug;
            function tick75() {
              var h = document.documentElement;
              var max = h.scrollHeight - h.clientHeight;
              if (max > 0 && window.scrollY / max >= 0.75) past75 = true;
            }
            window.addEventListener("scroll", tick75, { passive: true });
            cleanups.push(function () { window.removeEventListener("scroll", tick75); });
            var dTimer = setInterval(function () {
              dwell += 5;
              if (past75 && dwell >= 30 && !didRead && !sessionStorage.getItem(arKey)) {
                didRead = true; sessionStorage.setItem(arKey, "1");
                fire("article_read", { article_slug: slug, dwell_seconds: dwell });
              }
            }, 5000);
            cleanups.push(function () { clearInterval(dTimer); });
          }

          /* 4 — Outbound + WhatsApp clicks */
          function onClickLink(e) {
            var a = e.target && e.target.closest("a");
            if (!a || !a.href) return;
            try {
              var u = new URL(a.href);
              if (u.hostname === location.hostname) return;
              if (/wa\.me|whatsapp\.com/.test(u.hostname)) {
                fire("whatsapp_click", { page_type: ptype });
                // Meta Pixel — Contact event para clique direto no WhatsApp
                if (typeof window.fbq === "function" && pixelId) {
                  window.fbq("track", "Contact", { content_name: "whatsapp-direto", page_type: ptype });
                }
              }
              fire("outbound_click", { link_url: a.href, link_domain: u.hostname, link_text: (a.textContent || "").trim().slice(0, 100), page_type: ptype });
            } catch (_) {}
          }
          document.addEventListener("click", onClickLink);
          cleanups.push(function () { document.removeEventListener("click", onClickLink); });

          /* 5 — Share clicks */
          function onShare(e) {
            var btn = e.target && (e.target.closest("[data-share]") || e.target.closest(".sr-share a"));
            if (!btn) return;
            fire("share_click", { method: (btn.dataset && btn.dataset.share) ? btn.dataset.share : "link", content_type: ptype });
          }
          document.addEventListener("click", onShare);
          cleanups.push(function () { document.removeEventListener("click", onShare); });

          /* 6 — Pagefind search queries */
          function onSearch(e) {
            var q = e.detail && (e.detail.query || e.detail.term);
            if (q) fire("search", { search_term: q, search_source: "pagefind" });
          }
          document.addEventListener("pagefind:search", onSearch);
          document.addEventListener("pagefind-search", onSearch);
          cleanups.push(function () {
            document.removeEventListener("pagefind:search", onSearch);
            document.removeEventListener("pagefind-search", onSearch);
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init, { once: true });
        } else { init(); }
        document.addEventListener("astro:page-load", init);
      })();
    </script>
  </body>
</html>
