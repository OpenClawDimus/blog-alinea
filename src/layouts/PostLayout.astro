---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  postTitle?: string;
  faq?: { q: string; a: string }[];
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  postTitle,
  faq,
} = Astro.props;

const pageUrl =
  canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const orgUrl = site.profile || site.url;
const siteBase = (Astro.site ?? new URL(site.url)).href
const orgId = `${siteBase}#organization`

const publisher = {
  "@type": "Organization",
  "@id": orgId,
  name: "Dimus",
  url: orgUrl,
  logo: {
    "@type": "ImageObject",
    "@id": `${siteBase}#logo`,
    url: new URL("logo-dimus.png", siteBase).href,
    contentUrl: new URL("logo-dimus.png", siteBase).href,
    width: 512,
    height: 512,
  },
};

// E-E-A-T: autor real (Person) com expertise explícita — sinal de autoridade para Google e LLMs
const eeatAuthor = {
  "@type": "Person",
  "@id": "https://guilhermeribeiro.me/#person",
  name: "Guilherme Ribeiro",
  url: "https://guilhermeribeiro.me",
  jobTitle: "Fundador",
  worksFor: { "@id": orgId },
  knowsAbout: [
    "marketing automotivo",
    "CRM para concessionárias",
    "gestão de leads automotivos",
    "atribuição de marketing digital",
    "revenda de veículos seminovos",
    "gestão de concessionárias",
  ],
  sameAs: [
    "https://www.instagram.com/guilhermeribeiro.me/",
    "https://dimus.com.br",
  ],
};

const article = {
  "@type": "BlogPosting",
  "@id": `${pageUrl}#article`,
  headline: postTitle ?? title ?? site.title,
  ...(description && { description }),
  ...(ogImage && {
    image: {
      "@type": "ImageObject",
      url: new URL(ogImage.startsWith("/") ? ogImage : `/${ogImage}`, siteBase).href,
      contentUrl: new URL(ogImage.startsWith("/") ? ogImage : `/${ogImage}`, siteBase).href,
      width: 1200,
      height: 630,
    },
  }),
  inLanguage: site.lang,
  url: pageUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [eeatAuthor],
  publisher,
};

const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: site.url },
    {
      "@type": "ListItem",
      position: 2,
      name: "Posts",
      item: new URL("posts/", site.url).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: postTitle ?? title ?? "",
      item: pageUrl,
    },
  ],
};

const faqPage =
  faq && faq.length
    ? {
        "@type": "FAQPage",
        mainEntity: faq.map(item => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }
    : null;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [article, breadcrumb, ...(faqPage ? [faqPage] : [])],
};
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />
    <meta property="article:author" content="https://guilhermeribeiro.me" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />

  <script define:vars={{ postSlug: Astro.url.pathname.match(/^\/posts\/([^/]+)\/?$/)?.[1] || "" }}>
    // ViewContent (estudo de tracking wf_f26e1b8f-44a): sinal anônimo pro Meta
    // CAPI de visita a post individual — evento novo, não toca leads/GHL/Supabase
    // (tracker.js trata como ANONYMOUS_EVENTS). Dispara 1x por carregamento real
    // de página (não em cada astro:after-swap re-render do mesmo slug).
    function fireViewContent() {
      if (!postSlug) return;
      const key = "dimus_vc_" + postSlug;
      if (window.sessionStorage.getItem(key)) return;
      window.sessionStorage.setItem(key, "1");
      fetch("/tracker", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          event_name: "ViewContent",
          lead_origin: postSlug,
          source: "blog",
          post_slug: postSlug,
        }),
      }).catch(() => {});
    }
    fireViewContent();
  </script>
</Layout>
