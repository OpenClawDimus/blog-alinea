---
/**
 * Calculadora de CAC / Custo-por-Carro-Vendido (B2) — lead magnet do cluster atribuição.
 * Tese Dimus: "marketing que mede carro vendido, não lead". Mostra a diferença
 * entre custo por LEAD (a métrica que engana) e custo por CARRO VENDIDO (a que importa).
 * Escreve window.__calc.summary → o LeadForm (withCalc) leva os números pro WhatsApp.
 */
import LeadForm from "./LeadForm.astro";

interface Props {
  postSlug: string;
  cluster?: string;
}
const { postSlug, cluster = "atribuicao" } = Astro.props;
---

<section class="calc not-prose" aria-label="Calculadora de custo por carro vendido">
  <header class="calc-head">
    <p class="calc-eyebrow">Calculadora · grátis</p>
    <h3 class="calc-title">Quanto te custa cada carro vendido — não cada lead?</h3>
    <p class="calc-sub">
      Lead barato não paga conta. O que paga é carro na rua. Veja a diferença
      entre o seu custo por lead e o seu custo por carro vendido.
    </p>
  </header>

  <div class="calc-grid">
    <label class="calc-field">
      <span>Investimento em mídia no mês</span>
      <input id="cac-inv" type="number" min="0" step="500" value="5000" />
    </label>
    <label class="calc-field">
      <span>Leads gerados no mês</span>
      <input id="cac-leads" type="number" min="0" step="5" value="100" />
    </label>
    <label class="calc-field">
      <span>Carros vendidos desses leads</span>
      <input id="cac-carros" type="number" min="0" step="1" value="4" />
    </label>
  </div>

  <div class="calc-out">
    <div class="calc-stat">
      <span class="calc-stat-k">Custo por lead</span>
      <strong id="cac-lead" class="calc-stat-v">R$ 50</strong>
    </div>
    <div class="calc-stat hi">
      <span class="calc-stat-k">Custo por carro vendido</span>
      <strong id="cac-carro" class="calc-stat-v">R$ 1.250</strong>
    </div>
    <div class="calc-stat">
      <span class="calc-stat-k">Conversão lead → venda</span>
      <strong id="cac-conv" class="calc-stat-v">4%</strong>
    </div>
  </div>

  <p id="cac-badge" class="calc-badge">● Atenção — muito lead, pouca venda</p>

  <details class="calc-premissas">
    <summary>Como ler essa conta</summary>
    <ul>
      <li><b>Custo por lead</b> é o que a maioria mede — e o que portal/CRM gostam de mostrar.</li>
      <li><b>Custo por carro vendido</b> é o que o seu caixa sente de verdade.</li>
      <li>Conversão baixa (lead que não vira carro) = você está pagando por volume, não por venda.</li>
    </ul>
  </details>

  <LeadForm
    idTag="blog-calc-atribuicao"
    postSlug={postSlug}
    cluster={cluster}
    withCalc
    magnet="calc-cac-carro-vendido"
    intent="Quero entender o meu custo real por carro vendido e como baixar isso."
    eyebrow="Seu custo por carro vendido está alto?"
    title="Recebe a leitura da sua conta de aquisição"
    sub="Manda seu contato. A gente mostra onde o investimento está virando lead-fantasma em vez de carro vendido — e o que muda isso."
    cta="Quero a leitura no WhatsApp →"
  />
</section>

<style>
  .calc {
    margin: 2.5rem 0;
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--hair);
    border-radius: 18px;
    background: var(--surface-2);
    box-shadow: var(--shadow-card);
  }
  .calc-eyebrow {
    margin: 0 0 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--magenta);
  }
  .calc-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.12;
    color: var(--ink);
  }
  .calc-sub {
    margin: 0 0 1.3rem;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .calc-grid {
    display: grid;
    gap: 1.1rem;
    margin-bottom: 1.3rem;
  }
  @media (min-width: 560px) {
    .calc-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .calc-field span {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .calc-field input {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--hair);
    border-radius: 10px;
    background: var(--bg-2);
    color: var(--ink);
    font: inherit;
    font-variant-numeric: tabular-nums;
  }
  .calc-field input:focus {
    outline: none;
    border-color: var(--magenta);
  }
  .calc-out {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 559px) {
    .calc-out {
      grid-template-columns: 1fr;
    }
  }
  .calc-stat {
    padding: 0.9rem 1rem;
    border: 1px solid var(--hair);
    border-radius: 12px;
    background: var(--bg-2);
  }
  .calc-stat.hi {
    border-color: var(--magenta);
    background:
      radial-gradient(140% 160% at 100% 0%, var(--hair-mag), transparent 65%),
      var(--bg-2);
  }
  .calc-stat-k {
    display: block;
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .calc-stat.hi .calc-stat-k {
    color: var(--magenta);
  }
  .calc-stat-v {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .calc-badge {
    margin: 0 0 1rem;
    padding: 0.5rem 0.8rem;
    display: inline-block;
    border: 1px solid var(--magenta);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--magenta);
  }
  .calc-premissas {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .calc-premissas summary {
    cursor: pointer;
    color: var(--dim);
  }
  .calc-premissas ul {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    line-height: 1.6;
  }
</style>

<script>
  function fmt(n: number) {
    return "R$ " + Math.round(n).toLocaleString("pt-BR");
  }
  function initCAC() {
    const inv = document.getElementById("cac-inv") as HTMLInputElement | null;
    if (!inv) return;
    const leads = document.getElementById("cac-leads") as HTMLInputElement;
    const carros = document.getElementById("cac-carros") as HTMLInputElement;
    const elLead = document.getElementById("cac-lead")!;
    const elCarro = document.getElementById("cac-carro")!;
    const elConv = document.getElementById("cac-conv")!;
    const badge = document.getElementById("cac-badge")!;

    function calc() {
      const i = Math.max(0, +inv!.value || 0);
      const l = Math.max(0, +leads.value || 0);
      const c = Math.max(0, +carros.value || 0);
      const perLead = l > 0 ? i / l : 0;
      const perCarro = c > 0 ? i / c : 0;
      const conv = l > 0 ? (c / l) * 100 : 0;

      elLead.textContent = l > 0 ? fmt(perLead) : "—";
      elCarro.textContent = c > 0 ? fmt(perCarro) : "—";
      elConv.textContent = l > 0 ? conv.toFixed(1).replace(".", ",") + "%" : "—";

      let txt, col;
      if (l === 0 || c === 0) {
        txt = "● Preencha os campos para ver sua conta";
        col = "#E1B33A";
      } else if (conv < 3) {
        txt = "● Crítico — muito lead, pouca venda";
        col = "#E1379E";
      } else if (conv <= 8) {
        txt = "● Atenção — dá para apertar a conversão";
        col = "#E1B33A";
      } else {
        txt = "● Saudável — seu lead vira carro";
        col = "#1faf54";
      }
      badge.textContent = txt;
      badge.style.color = col;
      badge.style.borderColor = col;

      const summary =
        l > 0 && c > 0
          ? `Invisto ${fmt(i)}/mês, gero ${l} leads e vendo ${c} carros: meu custo por carro vendido é ${fmt(perCarro)} (conversão ${conv.toFixed(1).replace(".", ",")}%).`
          : "";
      (window as unknown as { __calc: unknown }).__calc = { summary };
    }
    inv.addEventListener("input", calc);
    leads.addEventListener("input", calc);
    carros.addEventListener("input", calc);
    calc();
  }
  initCAC();
  document.addEventListener("astro:after-swap", initCAC);
</script>
