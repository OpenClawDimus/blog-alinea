---
/**
 * DimusHelp — GATE obrigatório. Todo post insere este bloco: o que a Dimus faz + como ajuda,
 * traduzido para a dor do ICP (carro vendido, não lead). CTA → WhatsApp.
 */
interface Props {
  postSlug: string;
  cluster?: string;
  variant?: "estoque" | "atribuicao" | "portal" | "atendimento" | "default";
}
const { postSlug, cluster = "", variant = "default" } = Astro.props;

const copy = {
  estoque: {
    title: "Como a Dimus destrava o giro do seu estoque",
    body: "A gente identifica a unidade que está travando seu caixa e dispara campanha dedicada por veículo — tráfego hiperlocal por modelo + atendimento instantâneo no WhatsApp. O foco não é gerar lead: é girar o carro certo antes do 60º dia, pelo preço certo, não pelo mais baixo.",
  },
  atribuicao: {
    title: "Como a Dimus mede o carro vendido (não o lead)",
    body: "Rastreamos cada real de mídia até a chave na mão do cliente: Pixel + CAPI + atribuição ponta-a-ponta num painel que mostra custo-por-carro-vendido por canal e criativo. Você para de pagar relatório de CTR e passa a ver o que vende.",
  },
  portal: {
    title: "Como a Dimus tira você da prateleira do portal",
    body: "Montamos seu canal de aquisição próprio (criativo + tráfego hiperlocal + rastreio) para você parar de comprar o mesmo lead que a loja do lado e de pagar por lead-fantasma. Neutro de fornecedor: não vendemos portal nem CRM, então falamos a verdade.",
  },
  atendimento: {
    title: "Como a Dimus mata o lead que esfria dentro da loja",
    body: "Acoplamos um loop de WhatsApp + IA que faz o primeiro contato em segundos e cadencia o follow-up (D+1, D+3) automático. A métrica que cobramos é tempo-até-1º-contato e lead→visita→venda — não volume de contato.",
  },
  default: {
    title: "Como a Dimus ajuda sua revenda",
    body: "Marketing que mede carro vendido, não lead. Montamos seu canal próprio, rastreamos cada real até a venda e acoplamos atendimento por WhatsApp + IA — para você girar estoque e parar de depender do portal. Neutro de fornecedor: não vendemos portal nem CRM.",
  },
}[variant];

// Origem canônica (idTag) do gate: blog-gate-<cluster>. O lead.ts monta o
// lead_ref completo (blog-gate-<cluster>-<tempo>-<rand>) e o [ID] no WhatsApp.
// NUNCA WhatsApp direto: mini-form (nome+email+telefone) → CAPI server-side →
// redirect WhatsApp. (Ver event-origins.json / docs/EVENT-NAMING.md.)
const gateCluster = variant === "default" ? "geral" : variant;
const gateOrigin = "blog-gate-" + gateCluster;
const intent =
  "Vim do blog e quero entender como a Dimus pode ajudar meu negócio a vender mais.";
---

<aside class="dimus-help not-prose" data-cluster={cluster}>
  <p class="dh-eyebrow">Dimus · marketing que mede carro vendido</p>
  <h3 class="dh-title">{copy.title}</h3>
  <p class="dh-body">{copy.body}</p>
  <form
    class="dh-form"
    data-lead
    data-idtag={gateOrigin}
    data-post-slug={postSlug}
    data-cluster={cluster || variant}
    data-intent={intent}
  >
    <input name="nome" placeholder="Seu nome" autocomplete="name" required />
    <input
      name="email"
      type="email"
      inputmode="email"
      placeholder="Seu melhor e-mail"
      autocomplete="email"
      required
    />
    <input
      name="whatsapp"
      type="tel"
      inputmode="tel"
      placeholder="WhatsApp com DDD"
      autocomplete="tel"
      required
    />
    <button type="submit" class="dh-cta">Falar com a Dimus →</button>
  </form>
  <p class="dh-fine">Deixe seu contato — retornamos no WhatsApp. Sem robô.</p>
</aside>

<script>
  import "@/scripts/lead";
</script>

<style>
  .dimus-help {
    margin: 2.75rem 0;
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--hair-mag);
    border-left: 3px solid var(--magenta);
    border-radius: 14px;
    background: linear-gradient(
      180deg,
      var(--surface),
      var(--bg-2)
    );
  }
  .dh-eyebrow {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--magenta);
  }
  .dh-title {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.15;
    color: var(--ink);
  }
  .dh-body {
    margin: 0 0 1.1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .dh-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .dh-form input {
    flex: 1 1 160px;
    min-width: 0;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--hair);
    border-radius: 10px;
    background: var(--bg-2);
    color: var(--ink);
    font: inherit;
    font-size: 0.92rem;
    transition: border-color 0.18s var(--ease-s);
  }
  .dh-form input::placeholder {
    color: var(--dim);
  }
  .dh-form input:focus {
    outline: none;
    border-color: var(--magenta);
  }
  .dh-cta {
    flex: 1 1 100%;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: var(--magenta);
    border: 1px solid var(--magenta);
    color: #fff;
    font: inherit;
    font-weight: 600;
    font-size: 0.94rem;
    cursor: pointer;
    transition:
      transform 0.18s var(--ease-s),
      filter 0.18s var(--ease-s);
  }
  .dh-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }
  .dh-fine {
    margin: 0.8rem 0 0;
    font-size: 0.76rem;
    color: var(--dim);
  }
</style>
