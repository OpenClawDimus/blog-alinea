---
/**
 * DimusHelp — GATE obrigatório. Todo post insere este bloco: o que a Dimus faz + como ajuda,
 * traduzido para a dor do ICP (carro vendido, não lead). CTA → WhatsApp.
 *
 * Props aceitas em dois estilos:
 *   Estilo legado : postSlug + cluster + variant
 *   Estilo MDX    : title + sub + items (override o copy do variant)
 * postSlug é auto-derivado da URL se não for passado explicitamente.
 */
interface Props {
  postSlug?: string;
  cluster?: string;
  variant?: "estoque" | "atribuicao" | "portal" | "atendimento" | "default";
  // Override props (MDX style — sobrescrevem o copy do variant)
  title?: string;
  sub?: string;
  items?: string[];
}
const {
  postSlug: postSlugProp,
  cluster = "",
  variant = "default",
  title: titleOverride,
  sub: subOverride,
} = Astro.props;

// Auto-deriva slug da URL se não passado — evita post_slug vazio no D1.
const postSlug =
  postSlugProp ||
  Astro.url.pathname.replace(/^\/posts\//, "").replace(/\/$/, "") ||
  "";

const variantCopy = {
  estoque: {
    title: "Como a Monumental estrutura o planejamento tributário da sua empresa",
    body: "Analisamos o enquadramento atual — Simples, Presumido ou Real — e simulamos com os seus números reais qual regime gera menor carga fiscal. O foco não é relatório: é economia documentada e segura, dentro da lei.",
  },
  atribuicao: {
    title: "Como a Monumental calcula sua economia tributária real",
    body: "Mapeamos toda a estrutura fiscal da empresa: regime, pró-labore, distribuição de lucros e créditos recuperáveis. O resultado é um número concreto de quanto você pode deixar de pagar — antes de qualquer mudança.",
  },
  portal: {
    title: "Como a Monumental posiciona sua empresa para o novo sistema tributário",
    body: "A Reforma Tributária 2026 (IBS, CBS, Split Payment) muda o fluxo de caixa de toda empresa. Mapeamos o impacto no seu negócio e ajustamos o planejamento antes que a mudança chegue na nota fiscal.",
  },
  atendimento: {
    title: "Como a Monumental atende empresas em Brasília-DF",
    body: "Contabilidade consultiva presencial e digital para empresas no DF. Cada cliente tem um contador dedicado com acesso direto — não um atendente. Da abertura à gestão mensal, com foco em redução legal de carga tributária.",
  },
  default: {
    title: "Como a Monumental Contabilidade pode ajudar sua empresa",
    body: "Contabilidade consultiva em Brasília-DF: planejamento tributário, escolha de regime, abertura de empresa e gestão mensal com foco em reduzir legalmente a carga fiscal. Sem robô, com contador dedicado.",
  },
}[variant];

// MDX-style overrides têm prioridade sobre o copy do variant.
const copy = {
  title: titleOverride ?? variantCopy.title,
  body: subOverride ?? variantCopy.body,
};

// Origem canônica (idTag) do gate: blog-gate-<cluster>. O lead.ts monta o
// lead_ref completo (blog-gate-<cluster>-<tempo>-<rand>) e o [ID] no WhatsApp.
// NUNCA WhatsApp direto: mini-form (nome+email+telefone) → CAPI server-side →
// redirect WhatsApp. (Ver event-origins.json / docs/EVENT-NAMING.md.)
const gateCluster = variant === "default" ? "geral" : variant;
const gateOrigin = "blog-gate-" + gateCluster;
const intent =
  "Vim do blog da Monumental e quero entender como estruturar melhor o planejamento tributário da minha empresa.";
---

<aside class="dimus-help not-prose" data-cluster={cluster}>
  <p class="dh-eyebrow">Monumental Contabilidade · Brasília-DF</p>
  <h3 class="dh-title">{copy.title}</h3>
  <p class="dh-body">{copy.body}</p>
  <form
    class="dh-form"
    data-lead
    data-idtag={gateOrigin}
    data-post-slug={postSlug}
    data-cluster={cluster || variant}
    data-intent={intent}
  >
    <input name="nome" placeholder="Seu nome" autocomplete="name" required />
    <input
      name="email"
      type="email"
      inputmode="email"
      placeholder="Seu melhor e-mail"
      autocomplete="email"
      required
    />
    <input
      name="whatsapp"
      type="tel"
      inputmode="tel"
      placeholder="WhatsApp com DDD"
      autocomplete="tel"
      required
    />
    <button type="submit" class="dh-cta">Falar com a Monumental →</button>
  </form>
  <p class="dh-fine">Deixe seu contato — retornamos no WhatsApp. Sem robô.</p>
</aside>

<script>
  import "@/scripts/lead";
</script>

<style>
  .dimus-help {
    margin: 2.75rem 0;
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--hair-mag);
    border-left: 3px solid var(--magenta);
    border-radius: 14px;
    background: linear-gradient(
      180deg,
      var(--surface),
      var(--bg-2)
    );
  }
  .dh-eyebrow {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--magenta);
  }
  .dh-title {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.15;
    color: var(--ink);
  }
  .dh-body {
    margin: 0 0 1.1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .dh-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .dh-form input {
    flex: 1 1 160px;
    min-width: 0;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--hair);
    border-radius: 10px;
    background: var(--bg-2);
    color: var(--ink);
    font: inherit;
    font-size: 0.92rem;
    transition: border-color 0.18s var(--ease-s);
  }
  .dh-form input::placeholder {
    color: var(--dim);
  }
  .dh-form input:focus {
    outline: none;
    border-color: var(--magenta);
  }
  .dh-cta {
    flex: 1 1 100%;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: var(--magenta);
    border: 1px solid var(--magenta);
    color: #fff;
    font: inherit;
    font-weight: 600;
    font-size: 0.94rem;
    cursor: pointer;
    transition:
      transform 0.18s var(--ease-s),
      filter 0.18s var(--ease-s);
  }
  .dh-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }
  .dh-fine {
    margin: 0.8rem 0 0;
    font-size: 0.76rem;
    color: var(--dim);
  }
</style>
