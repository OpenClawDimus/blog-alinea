---
import { humanizeTag } from "@/utils/humanizeTag";

interface Props {
  href: string;
  gradient: string;
  tag: string;
  title: string;
  date: Date;
  ogImage?: string | undefined;
  coverImage?: string | undefined;
  tall?: boolean;
  pinLabel?: string;
  readingTime?: number;
  description?: string;
}

const { href, gradient, tag, title, date, ogImage, coverImage, tall = false, pinLabel, readingTime, description } = Astro.props;
const cardImage = coverImage ?? ogImage;

const fmtDate = (d: Date) =>
  d.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });

// Real path from cult-ui CutoutCorner (viewBox 0 0 200 200)
// Concave notch is at top-left; rotate to change orientation
const CP = "M0 200C155.996 199.961 200.029 156.308 200 0V200H0Z";
---

<a href={href} class:list={["sr-cutcard sr-reveal", { "sr-cutcard--tall": tall }]}>

  <div class="sr-cutcard__media" style={`background:${gradient}`} aria-hidden="true">
    {cardImage && <img src={cardImage} alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" />}
    {!cardImage && <div class="sr-cutcard__noise"></div>}
    <div class="sr-cutcard__overlay"></div>

    {/* Pin badge — top-right corner, inside media so corners clip correctly */}
    {pinLabel && (
      <div class="sr-cutcard__pin">
        {/* Left side of pin — concave corner connecting pin to card top edge */}
        <svg class="sr-cc sr-cc--pin-l" width="24" height="24" viewBox="0 0 200 200" aria-hidden="true">
          <path d={CP} fill="currentColor" />
        </svg>
        {pinLabel}
        {/* Bottom of pin — concave corner connecting pin to card right edge */}
        <svg class="sr-cc sr-cc--pin-b" width="24" height="24" viewBox="0 0 200 200" aria-hidden="true">
          <path d={CP} fill="currentColor" />
        </svg>
      </div>
    )}

    {/* Inset label — bottom-left of media */}
    <div class="sr-cutcard__inset">
      {/* Above the inset at its left edge */}
      <svg class="sr-cc sr-cc--inset-t" width="32" height="32" viewBox="0 0 200 200" aria-hidden="true">
        <path d={CP} fill="currentColor" />
      </svg>
      <span class="sr-kicker">{humanizeTag(tag)}</span>
      {/* Right of inset at its bottom */}
      <svg class="sr-cc sr-cc--inset-r" width="32" height="32" viewBox="0 0 200 200" aria-hidden="true">
        <path d={CP} fill="currentColor" />
      </svg>
    </div>
  </div>

  <div class="sr-cutcard__body">
    <h3 class="sr-cutcard__title">{title}</h3>

    {tall && description && (
      <div class="sr-cutcard__desc-wrap">
        <p class="sr-cutcard__desc">{description}</p>
      </div>
    )}

    {readingTime && (
      <div class="sr-cutcard__peek" aria-hidden="true">
        <div class="sr-cutcard__peek-inner">
          <div class="sr-peek-content">
            <span class="sr-read-badge">⏱ {readingTime} min de leitura</span>
          </div>
        </div>
      </div>
    )}

    <div class="sr-cutcard__footer">
      <div class="sr-datastrip">
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
      </div>
      <span class="sr-cutcard__cta">Ler análise →</span>
    </div>
  </div>
</a>
