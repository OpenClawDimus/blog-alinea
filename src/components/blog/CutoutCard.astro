---
import { humanizeTag } from "@/utils/humanizeTag";

interface Props {
  href: string;
  tag: string;
  title: string;
  date: Date;
  ogImage?: string | undefined;
  coverImage?: string | undefined;
  readingTime?: number;
  description?: string;
  eager?: boolean;
  author?: string;
  // Legacy props (ignored in new design)
  gradient?: string;
  tall?: boolean;
  isNew?: boolean;
}

const { href, tag, title, date, ogImage, coverImage, readingTime, description, eager = false, author } = Astro.props;
const cardImage = coverImage ?? (ogImage && ogImage !== '/default-og.jpg' ? ogImage : undefined);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });
---

<a href={href} class="post-card sr-reveal">
  <div class="post-card-img">
    {cardImage
      ? <img src={cardImage} alt={title} loading={eager ? "eager" : "lazy"} decoding="async" onerror="this.parentElement.style.background='linear-gradient(135deg,#282e69 0%,#0a0c18 100%)'" />
      : <div style="width:100%;height:100%;background:linear-gradient(135deg,#282e69 0%,#0a0c18 100%)" aria-hidden="true"></div>
    }
  </div>
  <div class="post-card-body">
    <span class="post-card-cat">{humanizeTag(tag)}</span>
    <h3 class="post-card-title">{title}</h3>
    {description && <p class="post-card-excerpt">{description}</p>}
    <div class="post-card-footer">
      <span class="post-card-meta">
        {author ? `${author} · ` : ""}{fmtDate(date)}{readingTime ? ` · ${readingTime} min` : ""}
      </span>
      <span class="post-card-link">Ler →</span>
    </div>
  </div>
</a>
