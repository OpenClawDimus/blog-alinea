---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { humanizeTag } from "@/utils/humanizeTag";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const mainPosts = sortedPosts.filter(p => !p.id.endsWith("-reddit"));

// ── Featured: best post by GSC clicks → GA4 sessions → most recent ──
let featuredPost = mainPosts[0];

function extractSlug(url: string): string | null {
  const m = url.match(/\/posts\/([^/?#]+)\/?$/);
  return m ? m[1] : null;
}

function findPost(slug: string) {
  return mainPosts.find(p => p.id === slug || p.id === `${slug}/index`);
}

try {
  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? "https://tllelzquwdfcjjlsurai.supabase.co";
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  if (SB_KEY) {
    const gscRes = await fetch(
      `${SB_URL}/rest/v1/seoa_performance?select=page_url,clicks,position&source=eq.gsc&clicks=gt.0&order=clicks.desc,position.asc&limit=10`,
      { headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` } }
    );
    if (gscRes.ok) {
      const gscRows: Array<{ page_url: string; clicks: number; position: number }> = await gscRes.json();
      for (const row of gscRows) {
        const slug = extractSlug(row.page_url);
        const c = slug ? findPost(slug) : null;
        if (c) { featuredPost = c; break; }
      }
    }

    if (featuredPost === mainPosts[0]) {
      const ga4Res = await fetch(
        `${SB_URL}/rest/v1/seoa_performance?select=page_url,sessions&source=eq.ga4&sessions=gt.0`,
        { headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` } }
      );
      if (ga4Res.ok) {
        const ga4Rows: Array<{ page_url: string; sessions: number }> = await ga4Res.json();
        const bySlug = new Map<string, number>();
        for (const row of ga4Rows) {
          const slug = extractSlug(row.page_url);
          if (!slug) continue;
          bySlug.set(slug, (bySlug.get(slug) ?? 0) + (row.sessions ?? 0));
        }
        const ranked = [...bySlug.entries()].sort((a, b) => b[1] - a[1]);
        for (const [slug] of ranked) {
          const c = findPost(slug);
          if (c) { featuredPost = c; break; }
        }
      }
    }
  }
} catch { /* silently fall back to most recent */ }

const gridPosts = mainPosts.filter(p => p.id !== featuredPost?.id);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });

const getReadTime = (body: string | undefined) =>
  Math.ceil((body?.split(/\s+/).length ?? 800) / 220);

const author = config.site.authorPerson?.name ?? config.site.author;
const normImg = (p?: string) =>
  p ? (p.startsWith('http') || p.startsWith('/') ? p : `/${p}`) : undefined;
---

<Layout>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": `${(Astro.site ?? new URL(config.site.url)).href}#webpage`,
      "url": (Astro.site ?? new URL(config.site.url)).href,
      "name": config.site.title,
      "description": config.site.description,
      "isPartOf": { "@id": `${(Astro.site ?? new URL(config.site.url)).href}#website` },
      "inLanguage": config.site.lang,
    })} />
  </Fragment>

  <div class="al-page" id="main-content" data-layout="index" data-home-path={homePath}>

    <!-- ── Category pills (horizontal) ── -->
    <nav class="al-pills" aria-label="Filtrar por tema">
      <a href="/" class="al-pill al-pill--active">Todos</a>
      <a href="/tags/reforma-tributaria" class="al-pill">Reforma Tributária</a>
      <a href="/tags/planejamento-tributario" class="al-pill">Planejamento Fiscal</a>
      <a href="/tags/holding" class="al-pill">Holdings</a>
      <a href="/tags/simples-nacional" class="al-pill">Simples Nacional</a>
      <a href="/tags/abertura-empresa" class="al-pill">Abertura de Empresa</a>
      <a href="/tags/contabilidade-brasilia" class="al-pill">Brasília</a>
    </nav>

    <!-- ── Blog header ── -->
    <header class="al-hd sr-reveal">
      <span class="al-hd-eyebrow">Blog Alínea Finanças</span>
      <h1 class="al-hd-title">Gestão financeira e tributária<br/>para empresas em Brasília.</h1>
      <p class="al-hd-sub">Para empresários de Brasília-DF que querem decisões financeiras baseadas em número, não em achismo.</p>
    </header>

    <!-- ── Featured: 2-col grid (texto esquerda, imagem direita) ── -->
    {featuredPost && (() => {
      const featImg = normImg(featuredPost.data.coverImage) ?? (typeof featuredPost.data.ogImage === "string" ? featuredPost.data.ogImage : undefined);
      return (
        <a href={`/posts/${featuredPost.id}/`} class="al-hero sr-reveal">
          <div class="al-hero-text">
            <span class="al-hero-chip">Destaque</span>
            <h2 class="al-hero-title">{featuredPost.data.title}</h2>
            <p class="al-hero-desc">{featuredPost.data.description}</p>
            <div class="al-hero-footer">
              <span class="al-hero-meta">{fmtDate(featuredPost.data.pubDatetime)} · {getReadTime(featuredPost.body)} min</span>
              <span class="al-hero-cta">Ler artigo →</span>
            </div>
          </div>
          <div class="al-hero-img">
            {featImg
              ? <img src={featImg} alt={featuredPost.data.title} loading="eager" fetchpriority="high" decoding="async" />
              : <div class="al-hero-img-fallback" aria-hidden="true"></div>
            }
          </div>
        </a>
      );
    })()}

    <!-- ── Dados em destaque ── -->
    <div class="al-stats sr-reveal">
      <div class="al-stat">
        <span class="al-stat-n">200+</span>
        <span class="al-stat-l">Empresas atendidas</span>
      </div>
      <div class="al-stat">
        <span class="al-stat-n">8 anos</span>
        <span class="al-stat-l">No mercado financeiro</span>
      </div>
      <div class="al-stat">
        <span class="al-stat-n">Brasília</span>
        <span class="al-stat-l">Sede e área de atuação</span>
      </div>
    </div>

    <!-- ── Section header ── -->
    <div class="al-section-hd">
      <span class="al-section-label">Artigos recentes</span>
      <a href="/posts" class="al-section-link">Ver todos →</a>
    </div>

    <!-- ── Post list (fintech/data style) ── -->
    {gridPosts.length > 0 && (
      <div class="al-post-list">
        {gridPosts.map((post, i) => {
          const img = normImg(post.data.coverImage) ?? (typeof post.data.ogImage === "string" ? post.data.ogImage : undefined);
          const tag = post.data.tags[0] ?? "análise";
          return (
            <a href={`/posts/${post.id}/`} class="al-post-item sr-reveal">
              {img && (
                <div class="al-post-thumb">
                  <img src={img} alt={post.data.title} loading={i < 4 ? "eager" : "lazy"} decoding="async" />
                </div>
              )}
              <div class="al-post-body">
                <span class="al-post-chip">{humanizeTag(tag)}</span>
                <h3 class="al-post-title">{post.data.title}</h3>
                <p class="al-post-desc">{post.data.description}</p>
                <div class="al-post-meta">
                  <span>{fmtDate(post.data.pubDatetime)}</span>
                  <span class="al-post-dot">·</span>
                  <span>{getReadTime(post.body)} min</span>
                </div>
              </div>
              <div class="al-post-arrow" aria-hidden="true">→</div>
            </a>
          );
        })}
      </div>
    )}

    <!-- ── Newsletter ── -->
    <section class="sr-news-fold sr-reveal" aria-labelledby="nl-heading" style="margin-top:56px">
      <p class="sr-eyebrow">Newsletter</p>
      <h2 id="nl-heading">
        Toda semana: o que muda na <em>sua carga tributária</em>
      </h2>
      <p>
        Reforma Tributária, planejamento fiscal e contabilidade consultiva.
        Direto para o sócio e gestor financeiro que toma decisão.
      </p>
      <form id="home-nl-form" onsubmit="submitHomeNewsletter(event)" style="display:flex;gap:10px;width:min(520px,100%)">
        <div class="sr-field" style="flex:1">
          <input type="text" name="nome" placeholder="Seu nome" required autocomplete="given-name" />
        </div>
        <div class="sr-field" style="flex:1.5">
          <input type="email" name="email" placeholder="Seu e-mail" required autocomplete="email" />
        </div>
        <button type="submit" class="sr-btn" style="white-space:nowrap;font-size:13px;padding:10px 20px">Quero →</button>
      </form>
      <p id="home-nl-msg" style="font-family:var(--font-mono);font-size:12px;color:var(--magenta);display:none;margin-top:10px">
        ✓ Inscrito! Toda semana na sua caixa.
      </p>
      <p id="home-nl-err" style="font-family:var(--font-mono);font-size:12px;color:#e11;display:none;margin-top:10px">
        Erro ao inscrever. Tente novamente.
      </p>
      <div class="sr-proof">
        <span><b>100%</b> sem spam</span>
        <span>·</span>
        <span>Cancelar a qualquer momento</span>
        <span>·</span>
        <span><b>blog.alineafinancas.com.br</b></span>
      </div>
    </section>

  </div>

  <script>
    document.addEventListener("astro:page-load", () => {
      const el = document.querySelector("#main-content") as HTMLElement;
      if (el?.dataset.layout) {
        const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
        sessionStorage.setItem("backUrl", el.dataset.homePath ?? baseRoot);
      }
    });

    (window as any).submitHomeNewsletter = async function(e: Event) {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = form.querySelector("button") as HTMLButtonElement;
      const nome = (form.elements.namedItem("nome") as HTMLInputElement).value.trim();
      const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
      const msgEl = document.getElementById("home-nl-msg");
      const errEl = document.getElementById("home-nl-err");
      if (btn) btn.disabled = true;
      try {
        const res = await fetch("/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ nome, email }),
        });
        if (res.ok) {
          form.reset();
          if (msgEl) msgEl.style.display = "block";
          if (errEl) errEl.style.display = "none";
          const gtag = (window as any).gtag;
          if (gtag) gtag("event", "generate_lead", { lead_source: "blog", lead_type: "newsletter" });
        } else {
          if (errEl) errEl.style.display = "block";
          if (msgEl) msgEl.style.display = "none";
        }
      } catch {
        if (errEl) errEl.style.display = "block";
        if (msgEl) msgEl.style.display = "none";
      }
      if (btn) btn.disabled = false;
    };
  </script>
</Layout>
