---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import CutoutCard from "@/components/blog/CutoutCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { humanizeTag } from "@/utils/humanizeTag";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const mainPosts = sortedPosts.filter(p => !p.id.endsWith("-reddit"));

// ── Featured: best post by GSC clicks → GA4 sessions → most recent ──
let featuredPost = mainPosts[0];

function extractSlug(url: string): string | null {
  const m = url.match(/\/posts\/([^/?#]+)\/?$/);
  return m ? m[1] : null;
}

function findPost(slug: string) {
  return mainPosts.find(p => p.id === slug || p.id === `${slug}/index`);
}

try {
  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? "https://tllelzquwdfcjjlsurai.supabase.co";
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  if (SB_KEY) {
    const gscRes = await fetch(
      `${SB_URL}/rest/v1/seoa_performance?select=page_url,clicks,position&source=eq.gsc&clicks=gt.0&order=clicks.desc,position.asc&limit=10`,
      { headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` } }
    );
    if (gscRes.ok) {
      const gscRows: Array<{ page_url: string; clicks: number; position: number }> = await gscRes.json();
      for (const row of gscRows) {
        const slug = extractSlug(row.page_url);
        const c = slug ? findPost(slug) : null;
        if (c) { featuredPost = c; break; }
      }
    }

    if (featuredPost === mainPosts[0]) {
      const ga4Res = await fetch(
        `${SB_URL}/rest/v1/seoa_performance?select=page_url,sessions&source=eq.ga4&sessions=gt.0`,
        { headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` } }
      );
      if (ga4Res.ok) {
        const ga4Rows: Array<{ page_url: string; sessions: number }> = await ga4Res.json();
        const bySlug = new Map<string, number>();
        for (const row of ga4Rows) {
          const slug = extractSlug(row.page_url);
          if (!slug) continue;
          bySlug.set(slug, (bySlug.get(slug) ?? 0) + (row.sessions ?? 0));
        }
        const ranked = [...bySlug.entries()].sort((a, b) => b[1] - a[1]);
        for (const [slug] of ranked) {
          const c = findPost(slug);
          if (c) { featuredPost = c; break; }
        }
      }
    }
  }
} catch { /* silently fall back to most recent */ }

const gridPosts = mainPosts.filter(p => p.id !== featuredPost?.id);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });

const getReadTime = (body: string | undefined) =>
  Math.ceil((body?.split(/\s+/).length ?? 800) / 220);

const author = config.site.authorPerson?.name ?? config.site.author;
---

<Layout>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": `${(Astro.site ?? new URL(config.site.url)).href}#webpage`,
      "url": (Astro.site ?? new URL(config.site.url)).href,
      "name": config.site.title,
      "description": config.site.description,
      "isPartOf": { "@id": `${(Astro.site ?? new URL(config.site.url)).href}#website` },
      "inLanguage": config.site.lang,
    })} />
  </Fragment>

  <div class="blog-wrap">

    <!-- ── Sidebar ── -->
    <aside class="blog-sidebar" aria-label="Filtros e categorias">
      <span class="sb-label">Buscar</span>
      <a href="/search" class="sb-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        Buscar artigos…
      </a>

      <span class="sb-label">Categorias</span>
      <ul class="sb-cat-list">
        <li><a href="/" class="sb-cat-item" data-active="">Todas</a></li>
        <li><a href="/tags/reforma-tributaria" class="sb-cat-item">Reforma Tributária</a></li>
        <li><a href="/tags/planejamento-tributario" class="sb-cat-item">Planejamento Fiscal</a></li>
        <li><a href="/tags/holding" class="sb-cat-item">Holdings</a></li>
        <li><a href="/tags/simples-nacional" class="sb-cat-item">Simples Nacional</a></li>
        <li><a href="/tags/abertura-empresa" class="sb-cat-item">Abertura de Empresa</a></li>
        <li><a href="/tags/contabilidade-brasilia" class="sb-cat-item">Contabilidade Brasília</a></li>
        <li><a href="/tags/fornecedores-governo" class="sb-cat-item">Fornecedores do Governo</a></li>
      </ul>
    </aside>

    <!-- ── Main ── -->
    <main id="main-content" data-layout="index" data-home-path={homePath} class="blog-main">

      <!-- Blog header -->
      <header class="blog-hd sr-reveal">
        <span class="blog-hd-eyebrow">Blog ))) Monumental</span>
        <h1 class="blog-hd-title">Inteligência tributária para quem decide.</h1>
        <p class="blog-hd-sub">Para empresários de Brasília-DF que querem decisões fiscais baseadas em número, não em achismo.</p>
      </header>

      <!-- Featured story -->
      {featuredPost && (
        <a href={`/posts/${featuredPost.id}/`} class="feat-story sr-reveal">
          <div class="feat-img">
            {(featuredPost.data.coverImage || typeof featuredPost.data.ogImage === "string")
              ? <img
                  src={featuredPost.data.coverImage ?? (typeof featuredPost.data.ogImage === "string" ? featuredPost.data.ogImage : undefined)}
                  alt={featuredPost.data.title}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              : <div class="feat-img-fallback" aria-hidden="true"></div>
            }
          </div>
          <div class="feat-overlay">
            <div class="feat-overlay-inner">
              <span class="feat-badge">Destaque</span>
              <h2 class="feat-title">{featuredPost.data.title}</h2>
              <p class="feat-excerpt">{featuredPost.data.description}</p>
              <div class="feat-footer">
                <span class="feat-author-name">{author}</span>
                <span class="feat-time">{fmtDate(featuredPost.data.pubDatetime)} · {getReadTime(featuredPost.body)} min</span>
                <span class="feat-read-btn">Ler artigo →</span>
              </div>
            </div>
          </div>
        </a>
      )}

      <!-- Filter bar -->
      <nav class="filter-bar" aria-label="Filtrar por tema">
        <a href="/" class="filter-tab on">Todos</a>
        <a href="/tags/reforma-tributaria" class="filter-tab">Reforma Tributária</a>
        <a href="/tags/planejamento-tributario" class="filter-tab">Planejamento Fiscal</a>
        <a href="/tags/holding" class="filter-tab">Holdings</a>
        <a href="/tags/simples-nacional" class="filter-tab">Simples Nacional</a>
        <a href="/tags/abertura-empresa" class="filter-tab">Abertura de Empresa</a>
      </nav>

      <!-- Post grid -->
      {gridPosts.length > 0 && (
        <div class="post-grid">
          {gridPosts.map((post, i) => (
            <CutoutCard
              href={`/posts/${post.id}/`}
              tag={post.data.tags[0] ?? "análise"}
              title={post.data.title}
              date={post.data.pubDatetime}
              ogImage={typeof post.data.ogImage === "string" ? post.data.ogImage : undefined}
              coverImage={post.data.coverImage}
              eager={i < 2}
              readingTime={getReadTime(post.body)}
              description={post.data.description}
              author={author}
            />
          ))}
        </div>
      )}

      <!-- Newsletter -->
      <section class="sr-news-fold sr-reveal" aria-labelledby="nl-heading" style="margin-top:56px">
        <p class="sr-eyebrow">Newsletter</p>
        <h2 id="nl-heading">
          Toda semana: o que muda na <em>sua carga tributária</em>
        </h2>
        <p>
          Reforma Tributária, planejamento fiscal e contabilidade consultiva.
          Direto para o sócio e gestor financeiro que toma decisão.
        </p>
        <form id="home-nl-form" onsubmit="submitHomeNewsletter(event)" style="display:flex;gap:10px;width:min(520px,100%)">
          <div class="sr-field" style="flex:1">
            <input type="text" name="nome" placeholder="Seu nome" required autocomplete="given-name" />
          </div>
          <div class="sr-field" style="flex:1.5">
            <input type="email" name="email" placeholder="Seu e-mail" required autocomplete="email" />
          </div>
          <button type="submit" class="sr-btn" style="white-space:nowrap;font-size:13px;padding:10px 20px">Quero →</button>
        </form>
        <p id="home-nl-msg" style="font-family:var(--font-mono);font-size:12px;color:var(--magenta);display:none;margin-top:10px">
          ✓ Inscrito! Toda semana na sua caixa.
        </p>
        <p id="home-nl-err" style="font-family:var(--font-mono);font-size:12px;color:#e11;display:none;margin-top:10px">
          Erro ao inscrever. Tente novamente.
        </p>
        <div class="sr-proof">
          <span><b>100%</b> sem spam</span>
          <span>·</span>
          <span>Cancelar a qualquer momento</span>
          <span>·</span>
          <span><b>blog.monumentalcontabilidade.com.br</b></span>
        </div>
      </section>

    </main>
  </div>

  <script>
    document.addEventListener("astro:page-load", () => {
      const el = document.querySelector("#main-content") as HTMLElement;
      if (el?.dataset.layout) {
        const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
        sessionStorage.setItem("backUrl", el.dataset.homePath ?? baseRoot);
      }
    });

    (window as any).submitHomeNewsletter = async function(e: Event) {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = form.querySelector("button") as HTMLButtonElement;
      const nome = (form.elements.namedItem("nome") as HTMLInputElement).value.trim();
      const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
      const msgEl = document.getElementById("home-nl-msg");
      const errEl = document.getElementById("home-nl-err");
      if (btn) btn.disabled = true;
      try {
        const res = await fetch("/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ nome, email }),
        });
        if (res.ok) {
          form.reset();
          if (msgEl) msgEl.style.display = "block";
          if (errEl) errEl.style.display = "none";
          const gtag = (window as any).gtag;
          if (gtag) gtag("event", "generate_lead", { lead_source: "blog", lead_type: "newsletter" });
        } else {
          if (errEl) errEl.style.display = "block";
          if (msgEl) msgEl.style.display = "none";
        }
      } catch {
        if (errEl) errEl.style.display = "block";
        if (msgEl) msgEl.style.display = "none";
      }
      if (btn) btn.disabled = false;
    };
  </script>
</Layout>
