---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import CutoutCard from "@/components/blog/CutoutCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { humanizeTag } from "@/utils/humanizeTag";
import config from "@/config";
import { getWhatsAppUrl } from "@/utils/getWhatsAppUrl";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
// Excluir variantes -reddit da home (conteúdo de FAQ duplicado)
const mainPosts = sortedPosts.filter(p => !p.id.endsWith("-reddit"));

// ── Motor de destaque: melhor post por indicadores ──────────────────────────
// Prioridade: (1) GSC clicks, (2) GA4 sessions agregadas, (3) post mais recente.
// Fonte: seoa_performance (Supabase). Fallback graceful em qualquer erro.
let featuredPost = mainPosts[0];

function extractSlug(url: string): string | null {
  const m = url.match(/\/posts\/([^/?#]+)\/?$/);
  return m ? m[1] : null;
}

function findPost(slug: string) {
  return mainPosts.find(p => p.id === slug || p.id === `${slug}/index`);
}

try {
  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? "https://tllelzquwdfcjjlsurai.supabase.co";
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  if (SB_KEY) {
    // 1ª tentativa: GSC clicks (orgânico real)
    const gscRes = await fetch(
      `${SB_URL}/rest/v1/seoa_performance?select=page_url,clicks,position&source=eq.gsc&clicks=gt.0&order=clicks.desc,position.asc&limit=10`,
      { headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` } }
    );
    if (gscRes.ok) {
      const gscRows: Array<{ page_url: string; clicks: number; position: number }> = await gscRes.json();
      for (const row of gscRows) {
        const slug = extractSlug(row.page_url);
        const c = slug ? findPost(slug) : null;
        if (c) { featuredPost = c; break; }
      }
    }

    // 2ª tentativa: GA4 sessions por post (quando GSC ainda sem clicks)
    if (featuredPost === mainPosts[0]) {
      const ga4Res = await fetch(
        `${SB_URL}/rest/v1/seoa_performance?select=page_url,sessions&source=eq.ga4&sessions=gt.0`,
        { headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` } }
      );
      if (ga4Res.ok) {
        const ga4Rows: Array<{ page_url: string; sessions: number }> = await ga4Res.json();
        // Agrega sessions por slug (múltiplas linhas por dia)
        const bySlug = new Map<string, number>();
        for (const row of ga4Rows) {
          const slug = extractSlug(row.page_url);
          if (!slug) continue;
          bySlug.set(slug, (bySlug.get(slug) ?? 0) + (row.sessions ?? 0));
        }
        // Ordena por sessions DESC, pega o primeiro que existe nos posts
        const ranked = [...bySlug.entries()].sort((a, b) => b[1] - a[1]);
        for (const [slug] of ranked) {
          const c = findPost(slug);
          if (c) { featuredPost = c; break; }
        }
      }
    }
  }
} catch { /* silently fall back to most recent */ }

const gridPosts = mainPosts.filter(p => p.id !== featuredPost?.id).slice(0, 2);
const row3Posts = mainPosts.filter(p => p.id !== featuredPost?.id).slice(2, 5);

// Badge "NOVO" para posts publicados nos últimos 7 dias
const NEW_THRESHOLD_MS = 7 * 24 * 60 * 60 * 1000;
const isNew = (d: Date) => Date.now() - d.getTime() < NEW_THRESHOLD_MS;

// Gradient por cluster de tags
const TAG_GRADIENT: Record<string, string> = {
  "reforma-tributaria":       "linear-gradient(135deg,#0d1a22 0%,#0f2d3d 45%,#103a4a 100%)",
  "planejamento-tributario":  "linear-gradient(135deg,#0d220d 0%,#0f3d0f 45%,#103a10 100%)",
  "fornecedor-governo":       "linear-gradient(135deg,#1a0d22 0%,#2d0f3d 45%,#4a1060 100%)",
  "contabilidade-consultiva": "linear-gradient(135deg,#22100d 0%,#3d1f0f 45%,#4a2010 100%)",
  "holding":                  "linear-gradient(135deg,#1a1a0d 0%,#2d2d0f 45%,#3d3010 100%)",
  "tributario":               "linear-gradient(135deg,#220d1a 0%,#3d0f2a 45%,#5a1040 100%)",
  default:                    "linear-gradient(135deg,#13101a 0%,#1e1528 45%,#2a1940 100%)",
};
const getGrad = (tags: string[]) =>
  TAG_GRADIENT[tags[0]] ?? TAG_GRADIENT.default;

const fmtDate = (d: Date) =>
  d.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });

const getReadTime = (body: string | undefined) =>
  Math.ceil((body?.split(/\s+/).length ?? 800) / 220);
---

<Layout>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": `${(Astro.site ?? new URL(config.site.url)).href}#webpage`,
      "url": (Astro.site ?? new URL(config.site.url)).href,
      "name": config.site.title,
      "description": config.site.description,
      "isPartOf": { "@id": `${(Astro.site ?? new URL(config.site.url)).href}#website` },
      "inLanguage": config.site.lang,
    })} />
  </Fragment>
  <!-- Topbar -->
  <nav class="sr-topbar" aria-label="Navegação principal">
    <div class="sr-topnav">
      <a href="/posts" data-active={Astro.url.pathname === "/posts" ? "" : undefined}>Posts</a>
      <a href="/tags">Tags</a>
      <a href="/about">Sobre</a>
    </div>
    <div style="display:flex;align-items:center;gap:14px">
      <a
        href={getWhatsAppUrl(config)}
        target="_blank"
        rel="noopener"
        class="sr-btn sr-btn-wa"
        style="font-size:13px;padding:8px 18px"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.117 1.523 5.847L0 24l6.342-1.493A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.374l-.357-.213-3.768.888.944-3.669-.235-.376A9.818 9.818 0 1112 21.818z"/></svg>
        WhatsApp
      </a>
    </div>
  </nav>

  <main id="main-content" data-layout="index" data-home-path={homePath} class="sr-wrap">

    <!-- Eyebrow + Brand Statement -->
    <p class="sr-eyebrow" style="margin-bottom:8px">Contabilidade consultiva · para empresas em Brasília</p>
    <p class="sr-brand-sub">Planejamento tributário, Reforma Tributária 2026 e gestão fiscal para quem precisa de número — não de generalidade.</p>

    <!-- ── Filtro por cluster ── -->
    <nav class="sr-filter-tabs" aria-label="Filtrar por tema">
      <a href="/" class="sr-ftab" data-active="">Todos</a>
      <a href="/tags/reforma-tributaria" class="sr-ftab">Reforma Tributária</a>
      <a href="/tags/planejamento-tributario" class="sr-ftab">Planejamento Fiscal</a>
      <a href="/tags/holding" class="sr-ftab">Holdings</a>
      <a href="/tags/simples-nacional" class="sr-ftab">Simples Nacional</a>
      <a href="/tags/abertura-empresa" class="sr-ftab">Abertura de Empresa</a>
    </nav>

    <!-- ── HERO (post em destaque) ── -->
    {featuredPost && (
      <a href={`/posts/${featuredPost.id}/`} class="sr-hero sr-reveal">
        <div class="cover" style={`background:${getGrad(featuredPost.data.tags)}`}>
          {(featuredPost.data.coverImage || typeof featuredPost.data.ogImage === "string") && (
            <img
              src={featuredPost.data.coverImage ?? (typeof featuredPost.data.ogImage === "string" ? featuredPost.data.ogImage : undefined)}
              alt=""
              aria-hidden="true"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          )}
        </div>
        <div class="body">
          <span class="sr-tag"><b>{humanizeTag(featuredPost.data.tags[0] ?? "")}</b></span>
          <h1 style="font-family:var(--font-display);font-weight:500;font-variation-settings:'opsz' 144;font-size:clamp(26px,3.2vw,46px);line-height:1.06;letter-spacing:-.025em;margin:14px 0 10px;max-width:28ch">
            {featuredPost.data.title}
          </h1>
          <p style="font-size:16px;max-width:56ch;margin:0 0 18px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{featuredPost.data.description}</p>
          <div class="sr-datastrip">
            {config.site.authorPerson?.avatar && (
              <img src={`/${config.site.authorPerson.avatar}`} alt={config.site.authorPerson.name} class="sr-avatar" style="width:26px;height:26px;object-fit:cover" />
            )}
            <span>{config.site.authorPerson?.name ?? config.site.author}</span>
            <span class="sr-dotsep"></span>
            <time datetime={featuredPost.data.pubDatetime.toISOString()}>
              {fmtDate(featuredPost.data.pubDatetime)}
            </time>
          </div>
        </div>
      </a>
    )}

    <!-- ── Seção: últimas análises ── -->
    {sortedPosts.length > 1 && (
      <>
        <div class="sr-section-head">
          <h2>Últimas publicações</h2>
          <a href="/posts">Ver todas <span aria-hidden="true">→</span></a>
        </div>

        <!-- Grid 2fr 1fr — CutoutCard -->
        {gridPosts.length > 0 && (
          <div class="sr-grid-asym">
            {gridPosts.map((post, i) => (
              <CutoutCard
                href={`/posts/${post.id}/`}
                gradient={getGrad(post.data.tags)}
                tag={post.data.tags[0] ?? "análise"}
                title={post.data.title}
                date={post.data.pubDatetime}
                ogImage={typeof post.data.ogImage === "string" ? post.data.ogImage : undefined}
                coverImage={post.data.coverImage}
                tall={i === 0}
                eager={i === 0}
                readingTime={getReadTime(post.body)}
                description={post.data.description}
                isNew={isNew(post.data.pubDatetime)}
              />
            ))}
          </div>
        )}

        <!-- Row de 3 — CutoutCard -->
        {row3Posts.length > 0 && (
          <div class="sr-row3">
            {row3Posts.map(post => (
              <CutoutCard
                href={`/posts/${post.id}/`}
                gradient={getGrad(post.data.tags)}
                tag={post.data.tags[0] ?? "análise"}
                title={post.data.title}
                date={post.data.pubDatetime}
                ogImage={typeof post.data.ogImage === "string" ? post.data.ogImage : undefined}
                coverImage={post.data.coverImage}
                readingTime={getReadTime(post.body)}
                description={post.data.description}
                isNew={isNew(post.data.pubDatetime)}
              />
            ))}
          </div>
        )}
      </>
    )}

    <!-- ── Newsletter fold ── -->
    <section class="sr-news-fold sr-reveal" aria-labelledby="nl-heading">
      <p class="sr-eyebrow">Newsletter</p>
      <h2 id="nl-heading">
        Toda semana: o que muda na <em>sua carga tributária</em>
      </h2>
      <p>
        Reforma Tributária, planejamento fiscal e contabilidade consultiva.
        Direto para o sócio e gestor financeiro que toma decisão.
      </p>
      <form id="home-nl-form" onsubmit="submitHomeNewsletter(event)" style="display:flex;gap:10px;width:min(520px,100%)">
        <div class="sr-field" style="flex:1">
          <input type="text" name="nome" placeholder="Seu nome" required autocomplete="given-name" />
        </div>
        <div class="sr-field" style="flex:1.5">
          <input type="email" name="email" placeholder="Seu e-mail" required autocomplete="email" />
        </div>
        <button type="submit" class="sr-btn" style="white-space:nowrap;font-size:13px;padding:10px 20px">Quero →</button>
      </form>
      <p id="home-nl-msg" style="font-family:var(--font-mono);font-size:12px;color:var(--magenta);display:none;margin-top:10px">
        ✓ Inscrito! Toda semana na sua caixa.
      </p>
      <p id="home-nl-err" style="font-family:var(--font-mono);font-size:12px;color:#e11;display:none;margin-top:10px">
        Erro ao inscrever. Tente novamente.
      </p>
      <div class="sr-proof">
        <span><b>100%</b> sem spam</span>
        <span>·</span>
        <span>Cancelar a qualquer momento</span>
        <span>·</span>
        <span><b>blog.monumentalcontabilidade.com.br</b></span>
      </div>
    </section>

  </main>

  <script>
    document.addEventListener("astro:page-load", () => {
      const el = document.querySelector("#main-content") as HTMLElement;
      if (el?.dataset.layout) {
        const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
        sessionStorage.setItem("backUrl", el.dataset.homePath ?? baseRoot);
      }
    });

    (window as any).submitHomeNewsletter = async function(e: Event) {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = form.querySelector("button") as HTMLButtonElement;
      const nome = (form.elements.namedItem("nome") as HTMLInputElement).value.trim();
      const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
      const msgEl = document.getElementById("home-nl-msg");
      const errEl = document.getElementById("home-nl-err");
      if (btn) btn.disabled = true;
      try {
        const res = await fetch("/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ nome, email }),
        });
        if (res.ok) {
          form.reset();
          if (msgEl) msgEl.style.display = "block";
          if (errEl) errEl.style.display = "none";
          // GA4 (estudo de tracking wf_f26e1b8f-44a) -- generate_lead nunca
          // disparava para inscrições feitas por este form (achado ao vivo).
          const gtag = (window as any).gtag;
          if (gtag) gtag("event", "generate_lead", { lead_source: "blog", lead_type: "newsletter" });
        } else {
          if (errEl) errEl.style.display = "block";
          if (msgEl) msgEl.style.display = "none";
        }
      } catch {
        if (errEl) errEl.style.display = "block";
        if (msgEl) msgEl.style.display = "none";
      }
      if (btn) btn.disabled = false;
    };
  </script>
</Layout>
