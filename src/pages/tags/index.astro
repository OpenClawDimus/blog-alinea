---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import { humanizeTag } from "@/utils/humanizeTag";
import config from "@/config";

const posts = await getCollection("posts");
const sorted = getSortedPosts(posts);
const tags = getUniqueTags(posts);

const countMap: Record<string, number> = {};
for (const { tag } of tags) {
  countMap[tag] = sorted.filter(p =>
    slugifyAll(p.data.tags).includes(tag)
  ).length;
}

const TAG_IMAGE: Record<string, string> = {
  "giro-de-estoque":    "/tags/giro-de-estoque.jpg",
  "carro-parado":       "/tags/carro-parado.jpg",
  "lead-fantasma":      "/tags/lead-fantasma.jpg",
  "seminovos":          "/tags/seminovos.jpg",
  "gestao":             "/tags/gestao.jpg",
  "aquisicao":          "/tags/aquisicao.jpg",
  "atribuicao":         "/tags/atribuicao.jpg",
  "metricas":           "/tags/metricas.jpg",
  "cac":                "/tags/cac.jpg",
  "ia-para-vendas":     "/tags/ia-para-vendas.jpg",
  "ia-para-negocios":   "/tags/ia-para-negocios.jpg",
  "automacao-marketing":"/tags/automacao-marketing.jpg",
  "automacao-whatsapp": "/tags/automacao-whatsapp.jpg",
  "agencia-ia":         "/tags/agencia-ia.jpg",
  "pmes":               "/tags/pmes.jpg",
  "chatbot":            "/tags/chatbot.jpg",
};

/*
 * ANTI-REGRESSION RULE — TAG IMAGES:
 * - Todas as 16 tags canônicas DEVEM ter entrada em TAG_IMAGE.
 * - Imagens ficam em /public/tags/<slug>.jpg (3:2, geradas via Minimax).
 * - Nunca adicionar tag fora do vocabulário canônico sem atualizar normalize_tags.py.
 * - Tint = overlay de cor por cluster. Nunca remover .sr-tag-card__tint.
 */
const TAG_TINT: Record<string, string> = {
  "giro-de-estoque":    "rgba(198,33,132,0.22)",
  "carro-parado":       "rgba(0,120,200,0.20)",
  "lead-fantasma":      "rgba(198,33,132,0.28)",
  "seminovos":          "rgba(200,150,0,0.18)",
  "gestao":             "rgba(0,180,100,0.18)",
  "aquisicao":          "rgba(220,80,0,0.18)",
  "atribuicao":         "rgba(0,100,220,0.20)",
  "metricas":           "rgba(180,0,0,0.18)",
  "cac":                "rgba(180,120,0,0.18)",
  "ia-para-vendas":     "rgba(0,200,200,0.18)",
  "ia-para-negocios":   "rgba(80,0,200,0.22)",
  "automacao-marketing":"rgba(198,33,132,0.22)",
  "automacao-whatsapp": "rgba(0,200,80,0.18)",
  "agencia-ia":         "rgba(198,33,132,0.28)",
  "pmes":               "rgba(200,100,0,0.18)",
  "chatbot":            "rgba(0,160,180,0.20)",
};

const TAG_GRADIENT: Record<string, string> = {
  "giro-de-estoque":    "linear-gradient(135deg,#1a0d22 0%,#2d0f3d 100%)",
  "carro-parado":       "linear-gradient(135deg,#0d1a22 0%,#103a4a 100%)",
  "lead-fantasma":      "linear-gradient(135deg,#220d1a 0%,#5a1040 100%)",
  "seminovos":          "linear-gradient(135deg,#1a1a0d 0%,#3d3010 100%)",
  "gestao":             "linear-gradient(135deg,#0d220d 0%,#103a10 100%)",
  "aquisicao":          "linear-gradient(135deg,#22100d 0%,#4a2010 100%)",
  "atribuicao":         "linear-gradient(135deg,#0d1222 0%,#102a4a 100%)",
  "metricas":           "linear-gradient(135deg,#1a0d0d 0%,#4a1212 100%)",
  "cac":                "linear-gradient(135deg,#1a150d 0%,#3a2a10 100%)",
  "ia-para-vendas":     "linear-gradient(135deg,#0d1a22 0%,#0f3d3d 100%)",
  "ia-para-negocios":   "linear-gradient(135deg,#0d0d22 0%,#10104a 100%)",
  "automacao-marketing":"linear-gradient(135deg,#220d22 0%,#4a1040 100%)",
  "automacao-whatsapp": "linear-gradient(135deg,#0d220d 0%,#104a20 100%)",
  "agencia-ia":         "linear-gradient(135deg,#13101a 0%,#2a1940 100%)",
  "pmes":               "linear-gradient(135deg,#22180d 0%,#3a2810 100%)",
  "chatbot":            "linear-gradient(135deg,#0d1a1a 0%,#103a3a 100%)",
  default:              "linear-gradient(135deg,#13101a 0%,#2a1940 100%)",
};

const getGrad = (tag: string) => TAG_GRADIENT[tag] ?? TAG_GRADIENT.default;
const getImg  = (tag: string) => TAG_IMAGE[tag]    ?? null;
const getTint = (tag: string) => TAG_TINT[tag]     ?? "rgba(198,33,132,0.18)";

const CLUSTER_AUTOMOTIVO = ["giro-de-estoque","carro-parado","lead-fantasma","seminovos","gestao","aquisicao","atribuicao","metricas","cac"];
const CLUSTER_IA         = ["ia-para-vendas","ia-para-negocios","automacao-marketing","automacao-whatsapp","agencia-ia","pmes","chatbot"];

const autoTags  = tags.filter(t => CLUSTER_AUTOMOTIVO.includes(t.tag));
const iaTags    = tags.filter(t => CLUSTER_IA.includes(t.tag));
const otherTags = tags.filter(t => !CLUSTER_AUTOMOTIVO.includes(t.tag) && !CLUSTER_IA.includes(t.tag));
---

<Layout title={`Tags | ${config.site.title}`}>
  <nav class="sr-topbar" aria-label="Navegação principal">
    <div class="sr-topnav">
      <a href="/posts">Posts</a>
      <a href="/tags" data-active="">Tags</a>
      <a href="/about">Sobre</a>
    </div>
    <a
      href="https://wa.me/5567991992882?text=Ol%C3%A1%21+Quero+saber+mais+sobre+marketing+automotivo"
      target="_blank" rel="noopener"
      class="sr-btn sr-btn-wa"
      style="font-size:13px;padding:8px 18px"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.76-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.117 1.523 5.847L0 24l6.342-1.493A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.374l-.357-.213-3.768.888.944-3.669-.235-.376A9.818 9.818 0 1112 21.818z"/></svg>
      WhatsApp
    </a>
  </nav>

  <main class="sr-wrap">
    <!-- H1 hero — dramatic lower-left -->
    <div class="sr-tags-hero">
      <p class="sr-eyebrow">Clusters editoriais</p>
      <h1 class="sr-tags-h1">Tags</h1>
      <p class="sr-tags-subtitle">Todos os temas cobertos nesta publicação. Clique para filtrar artigos.</p>
    </div>

    <!-- Cluster: Marketing Automotivo -->
    {autoTags.length > 0 && (
      <>
        <p class="sr-cluster-label">Marketing Automotivo</p>
        <div class="sr-tag-grid">
          {autoTags.map(({ tag, tagName }) => {
            const img = getImg(tag);
            return (
              <a href={`/tags/${tag}/`} class="sr-tag-card sr-reveal">
                <div class="sr-tag-card__clip" style={`background:${getGrad(tag)}`}>
                  {img && <img class="sr-tag-card__bg" src={img} alt="" aria-hidden="true" loading="lazy" decoding="async" />}
                  {img && <div class="sr-tag-card__tint" style={`background:${getTint(tag)}`}></div>}
                  <div class="sr-tag-card__overlay"></div>
                  <div class="sr-tag-card__body">
                    <span class="sr-tag-name">{humanizeTag(tagName)}</span>
                    <span class="sr-tag-count">{countMap[tag]} {countMap[tag] === 1 ? "artigo" : "artigos"}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </>
    )}

    <!-- Cluster: IA & Automação -->
    {iaTags.length > 0 && (
      <>
        <p class="sr-cluster-label" style="margin-top:40px">IA & Automação</p>
        <div class="sr-tag-grid">
          {iaTags.map(({ tag, tagName }) => {
            const img = getImg(tag);
            return (
              <a href={`/tags/${tag}/`} class="sr-tag-card sr-reveal">
                <div class="sr-tag-card__clip" style={`background:${getGrad(tag)}`}>
                  {img && <img class="sr-tag-card__bg" src={img} alt="" aria-hidden="true" loading="lazy" decoding="async" />}
                  {img && <div class="sr-tag-card__tint" style={`background:${getTint(tag)}`}></div>}
                  <div class="sr-tag-card__overlay"></div>
                  <div class="sr-tag-card__body">
                    <span class="sr-tag-name">{humanizeTag(tagName)}</span>
                    <span class="sr-tag-count">{countMap[tag]} {countMap[tag] === 1 ? "artigo" : "artigos"}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </>
    )}

    <!-- Outros (fallback) -->
    {otherTags.length > 0 && (
      <>
        <p class="sr-cluster-label" style="margin-top:40px">Outros</p>
        <div class="sr-tag-grid">
          {otherTags.map(({ tag, tagName }) => (
            <a href={`/tags/${tag}/`} class="sr-tag-card sr-reveal">
              <div class="sr-tag-card__clip" style={`background:${getGrad(tag)}`}>
                <div class="sr-tag-card__overlay"></div>
                <div class="sr-tag-card__body">
                  <span class="sr-tag-name">{humanizeTag(tagName)}</span>
                  <span class="sr-tag-count">{countMap[tag]} {countMap[tag] === 1 ? "artigo" : "artigos"}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </>
    )}
  </main>
</Layout>

<style>
/* ── H1 hero — dramatic lower-left anchor ─────────────────────────────── */
.sr-tags-hero {
  padding: 48px 0 28px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
}
.sr-tags-h1 {
  font-family: var(--font-display);
  font-size: clamp(60px, 9vw, 104px);
  font-weight: 700;
  line-height: 0.90;
  letter-spacing: -0.045em;
  color: var(--ink-1);
  margin: 0 0 4px -2px; /* -2px nudge left: breaks the grid margin intentionally */
}
.sr-tags-subtitle {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: .07em;
  color: var(--ink-3);
  max-width: 46ch;
  margin: 0;
}

/* ── Cluster label ─────────────────────────────────────────────────────── */
.sr-cluster-label {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin: 16px 0 14px;
}

/* ── Grid ──────────────────────────────────────────────────────────────── */
.sr-tag-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 16px;
}
@media (min-width: 640px) {
  .sr-tag-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 960px) {
  .sr-tag-grid { grid-template-columns: repeat(4, 1fr); }
}

/*
 * ── Card — border trail technique ──────────────────────────────────────
 *
 * ANTI-REGRESSION NOTE (do not remove this structure):
 *   .sr-tag-card = outer shell, NO overflow:hidden, holds the ::before border layer
 *   .sr-tag-card__clip = inner clip container, overflow:hidden, holds image + overlays
 *
 * The spinning conic-gradient on ::before lives in the 2px gap between card and clip.
 * Removing overflow:hidden from .sr-tag-card, or removing .sr-tag-card__clip,
 * will break the border trail animation.
 */
@property --angle {
  syntax: "<angle>";
  inherits: false;
  initial-value: 0deg;
}

.sr-tag-card {
  position: relative;
  border-radius: 14px;
  aspect-ratio: 3 / 2;
  display: flex;
  text-decoration: none;
  padding: 2px;
  /* subtle default border */
  outline: 1px solid rgba(255,255,255,0.06);
  transition: transform 0.22s ease, box-shadow 0.22s ease, outline-color 0.22s ease;
}

/* spinning conic border — shows in the 2px padding gap */
.sr-tag-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 14px;
  background: conic-gradient(
    from var(--angle),
    transparent  0%,
    transparent  35%,
    #c62184      48%,
    #ff66d0      52%,
    transparent  65%,
    transparent  100%
  );
  opacity: 0;
  transition: opacity 0.18s ease;
}
.sr-tag-card:hover::before {
  opacity: 1;
  animation: spin-border 1.6s linear infinite;
}
@keyframes spin-border {
  to { --angle: 360deg; }
}

/* lift + glow */
.sr-tag-card:hover {
  transform: translateY(-6px) scale(1.015);
  outline-color: transparent;
  box-shadow:
    0 20px 50px rgba(0,0,0,.65),
    0 0 28px rgba(198,33,132,.35);
}

/* ── Inner clip container ─────────────────────────────────────────────── */
.sr-tag-card__clip {
  position: relative;
  flex: 1;
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* ── Image & overlays ─────────────────────────────────────────────────── */
.sr-tag-card__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.45s ease;
  z-index: 1;
}
.sr-tag-card:hover .sr-tag-card__bg {
  transform: scale(1.07);
}

/* colour tint — brand hue blended into the photo */
.sr-tag-card__tint {
  position: absolute;
  inset: 0;
  z-index: 2;
  mix-blend-mode: multiply;
  pointer-events: none;
}

/* dark-to-clear gradient for text legibility */
.sr-tag-card__overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
  background: linear-gradient(
    to top,
    rgba(0,0,0,.90) 0%,
    rgba(0,0,0,.40) 45%,
    rgba(0,0,0,.06) 100%
  );
}

/* ── Text body ─────────────────────────────────────────────────────────── */
.sr-tag-card__body {
  position: relative;
  z-index: 4;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.sr-tag-name {
  font-family: var(--font-display);
  font-size: clamp(14px, 1.6vw, 19px);
  font-weight: 600;
  color: #fff;
  line-height: 1.15;
  text-shadow: 0 1px 6px rgba(0,0,0,.8);
}
.sr-tag-count {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: rgba(255,255,255,.65);
}
</style>
