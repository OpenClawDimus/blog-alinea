---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import { humanizeTag } from "@/utils/humanizeTag";
import config from "@/config";

const posts = await getCollection("posts");
const sorted = getSortedPosts(posts);
const tags = getUniqueTags(posts);

// post count per tag
const countMap: Record<string, number> = {};
for (const { tag } of tags) {
  countMap[tag] = sorted.filter(p =>
    slugifyAll(p.data.tags).includes(tag)
  ).length;
}

// Canonical tag images — all generated by Minimax, stored in /public/tags/
const TAG_IMAGE: Record<string, string> = {
  "giro-de-estoque":    "/tags/giro-de-estoque.jpg",
  "carro-parado":       "/tags/carro-parado.jpg",
  "lead-fantasma":      "/tags/lead-fantasma.jpg",
  "seminovos":          "/tags/seminovos.jpg",
  "gestao":             "/tags/gestao.jpg",
  "aquisicao":          "/tags/aquisicao.jpg",
  "atribuicao":         "/tags/atribuicao.jpg",
  "metricas":           "/tags/metricas.jpg",
  "cac":                "/tags/cac.jpg",
  "ia-para-vendas":     "/tags/ia-para-vendas.jpg",
  "ia-para-negocios":   "/tags/ia-para-negocios.jpg",
  "automacao-marketing":"/tags/automacao-marketing.jpg",
  "automacao-whatsapp": "/tags/automacao-whatsapp.jpg",
  "agencia-ia":         "/tags/agencia-ia.jpg",
  "pmes":               "/tags/pmes.jpg",
  "chatbot":            "/tags/chatbot.jpg",
};

// Gradient fallback per tag (used when image unavailable or as background blend)
const TAG_GRADIENT: Record<string, string> = {
  "giro-de-estoque":    "linear-gradient(135deg,#1a0d22 0%,#2d0f3d 100%)",
  "carro-parado":       "linear-gradient(135deg,#0d1a22 0%,#103a4a 100%)",
  "lead-fantasma":      "linear-gradient(135deg,#220d1a 0%,#5a1040 100%)",
  "seminovos":          "linear-gradient(135deg,#1a1a0d 0%,#3d3010 100%)",
  "gestao":             "linear-gradient(135deg,#0d220d 0%,#103a10 100%)",
  "aquisicao":          "linear-gradient(135deg,#22100d 0%,#4a2010 100%)",
  "atribuicao":         "linear-gradient(135deg,#0d1222 0%,#102a4a 100%)",
  "metricas":           "linear-gradient(135deg,#1a0d0d 0%,#4a1212 100%)",
  "cac":                "linear-gradient(135deg,#1a150d 0%,#3a2a10 100%)",
  "ia-para-vendas":     "linear-gradient(135deg,#0d1a22 0%,#0f3d3d 100%)",
  "ia-para-negocios":   "linear-gradient(135deg,#0d0d22 0%,#10104a 100%)",
  "automacao-marketing":"linear-gradient(135deg,#220d22 0%,#4a1040 100%)",
  "automacao-whatsapp": "linear-gradient(135deg,#0d220d 0%,#104a20 100%)",
  "agencia-ia":         "linear-gradient(135deg,#13101a 0%,#2a1940 100%)",
  "pmes":               "linear-gradient(135deg,#22180d 0%,#3a2810 100%)",
  "chatbot":            "linear-gradient(135deg,#0d1a1a 0%,#103a3a 100%)",
  default:              "linear-gradient(135deg,#13101a 0%,#2a1940 100%)",
};
const getGrad = (tag: string) => TAG_GRADIENT[tag] ?? TAG_GRADIENT.default;
const getImg  = (tag: string) => TAG_IMAGE[tag] ?? null;

// Cluster grouping for display
const CLUSTER_AUTOMOTIVO = ["giro-de-estoque","carro-parado","lead-fantasma","seminovos","gestao","aquisicao","atribuicao","metricas","cac"];
const CLUSTER_IA         = ["ia-para-vendas","ia-para-negocios","automacao-marketing","automacao-whatsapp","agencia-ia","pmes","chatbot"];

const autoTags = tags.filter(t => CLUSTER_AUTOMOTIVO.includes(t.tag));
const iaTags   = tags.filter(t => CLUSTER_IA.includes(t.tag));
const otherTags = tags.filter(t => !CLUSTER_AUTOMOTIVO.includes(t.tag) && !CLUSTER_IA.includes(t.tag));
---

<Layout title={`Tags | ${config.site.title}`}>
  <nav class="sr-topbar" aria-label="Navegação principal">
    <div class="sr-topnav">
      <a href="/posts">Posts</a>
      <a href="/tags" data-active="">Tags</a>
      <a href="/about">Sobre</a>
    </div>
    <a
      href="https://wa.me/5567991992882?text=Ol%C3%A1%21+Quero+saber+mais+sobre+marketing+automotivo"
      target="_blank" rel="noopener"
      class="sr-btn sr-btn-wa"
      style="font-size:13px;padding:8px 18px"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.117 1.523 5.847L0 24l6.342-1.493A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.374l-.357-.213-3.768.888.944-3.669-.235-.376A9.818 9.818 0 1112 21.818z"/></svg>
      WhatsApp
    </a>
  </nav>

  <main class="sr-wrap">
    <p class="sr-eyebrow" style="margin-bottom:0">Clusters editoriais</p>
    <h1 class="sr-archive-title">Tags</h1>
    <p class="sr-tags-desc">Todos os temas cobertos nesta publicação. Clique para filtrar os artigos por assunto.</p>

    <!-- ── Cluster: Marketing Automotivo ── -->
    {autoTags.length > 0 && (
      <>
        <p class="sr-cluster-label">Marketing Automotivo</p>
        <div class="sr-tag-grid">
          {autoTags.map(({ tag, tagName }) => {
            const img = getImg(tag);
            return (
              <a href={`/tags/${tag}/`} class="sr-tag-card sr-reveal" style={`background:${getGrad(tag)}`}>
                {img && <img class="sr-tag-card__bg" src={img} alt="" aria-hidden="true" loading="lazy" decoding="async" />}
                <div class="sr-tag-card__overlay"></div>
                <div class="sr-tag-card__body">
                  <span class="sr-tag-name">{humanizeTag(tagName)}</span>
                  <span class="sr-tag-count">{countMap[tag]} {countMap[tag] === 1 ? "artigo" : "artigos"}</span>
                </div>
              </a>
            );
          })}
        </div>
      </>
    )}

    <!-- ── Cluster: IA & Automação ── -->
    {iaTags.length > 0 && (
      <>
        <p class="sr-cluster-label" style="margin-top:40px">IA & Automação</p>
        <div class="sr-tag-grid">
          {iaTags.map(({ tag, tagName }) => {
            const img = getImg(tag);
            return (
              <a href={`/tags/${tag}/`} class="sr-tag-card sr-reveal" style={`background:${getGrad(tag)}`}>
                {img && <img class="sr-tag-card__bg" src={img} alt="" aria-hidden="true" loading="lazy" decoding="async" />}
                <div class="sr-tag-card__overlay"></div>
                <div class="sr-tag-card__body">
                  <span class="sr-tag-name">{humanizeTag(tagName)}</span>
                  <span class="sr-tag-count">{countMap[tag]} {countMap[tag] === 1 ? "artigo" : "artigos"}</span>
                </div>
              </a>
            );
          })}
        </div>
      </>
    )}

    <!-- ── Outros (caso apareçam tags fora do vocabulário canônico) ── -->
    {otherTags.length > 0 && (
      <>
        <p class="sr-cluster-label" style="margin-top:40px">Outros</p>
        <div class="sr-tag-grid">
          {otherTags.map(({ tag, tagName }) => (
            <a href={`/tags/${tag}/`} class="sr-tag-card sr-reveal" style={`background:${getGrad(tag)}`}>
              <div class="sr-tag-card__overlay"></div>
              <div class="sr-tag-card__body">
                <span class="sr-tag-name">{humanizeTag(tagName)}</span>
                <span class="sr-tag-count">{countMap[tag]} {countMap[tag] === 1 ? "artigo" : "artigos"}</span>
              </div>
            </a>
          ))}
        </div>
      </>
    )}
  </main>
</Layout>

<style>
.sr-cluster-label {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin: 32px 0 14px;
}

.sr-tag-card {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  aspect-ratio: 3 / 2;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  text-decoration: none;
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}
.sr-tag-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(0,0,0,.5);
}

.sr-tag-card__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.4s ease;
}
.sr-tag-card:hover .sr-tag-card__bg {
  transform: scale(1.04);
}

.sr-tag-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.82) 0%, rgba(0,0,0,.3) 50%, rgba(0,0,0,.08) 100%);
}

.sr-tag-card__body {
  position: relative;
  z-index: 1;
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sr-tag-name {
  font-family: var(--font-display);
  font-size: clamp(15px, 1.6vw, 19px);
  font-weight: 500;
  color: #fff;
  line-height: 1.2;
}
.sr-tag-count {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: rgba(255,255,255,.55);
}

.sr-tag-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 16px;
}
@media (min-width: 640px) {
  .sr-tag-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 960px) {
  .sr-tag-grid { grid-template-columns: repeat(4, 1fr); }
}
</style>
