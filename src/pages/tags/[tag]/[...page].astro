---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import { humanizeTag } from "@/utils/humanizeTag";
import config from "@/config";
import { getWhatsAppUrl } from "@/utils/getWhatsAppUrl";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getSortedPosts(
      posts.filter(({ data }) => slugifyAll(data.tags).includes(tag))
    );
    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName } = Astro.props;
const { tag } = Astro.params;

const TAG_GRADIENT: Record<string, string> = {
  "giro-de-estoque": "linear-gradient(135deg,#1a0d22 0%,#2d0f3d 45%,#4a1060 100%)",
  "seminovos":       "linear-gradient(135deg,#1a1a0d 0%,#2d2d0f 45%,#3d3010 100%)",
  "gestao":          "linear-gradient(135deg,#0d220d 0%,#0f3d0f 45%,#103a10 100%)",
  "aquisicao":       "linear-gradient(135deg,#22100d 0%,#3d1f0f 45%,#4a2010 100%)",
  "atribuicao":      "linear-gradient(135deg,#0d1222 0%,#0f1e3d 45%,#102a4a 100%)",
  "metricas":        "linear-gradient(135deg,#1a0d0d 0%,#3d1010 45%,#4a1212 100%)",
  "atendimento":     "linear-gradient(135deg,#0d1a1a 0%,#0f3030 45%,#103a3a 100%)",
  "whatsapp":        "linear-gradient(135deg,#0d1a0d 0%,#0f3d0f 45%,#103a10 100%)",
  "precificacao":    "linear-gradient(135deg,#1a0d1a 0%,#3a103a 45%,#4a1060 100%)",
  "indicacao":       "linear-gradient(135deg,#1a150d 0%,#3a2a10 45%,#4a3510 100%)",
  default:           "linear-gradient(135deg,#13101a 0%,#1e1528 45%,#2a1940 100%)",
};
const getGrad = (tags: string[]) =>
  TAG_GRADIENT[tags[0]] ?? TAG_GRADIENT.default;

const fmtDate = (d: Date) =>
  d.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });

const displayTag = humanizeTag(tagName);
---

<Layout title={`${displayTag} | ${config.site.title}`}>
  <main class="sr-wrap">
    <nav class="sr-crumb" aria-label="Breadcrumb" style="margin-bottom:28px">
      <a href="/">Início</a>
      <span class="sep" aria-hidden="true">›</span>
      <a href="/tags">Tags</a>
      <span class="sep" aria-hidden="true">›</span>
      <span style="color:var(--ink-2)">{displayTag}</span>
    </nav>

    <p class="sr-eyebrow" style="margin-bottom:0">Cluster</p>
    <h1 class="sr-archive-title">{displayTag}</h1>
    <p class="sr-tags-desc">{page.total} {page.total === 1 ? "artigo" : "artigos"} sobre este tema</p>

    <div class="sr-list-grid">
      {page.data.map((post) => (
        <a href={`/posts/${post.id}/`} class="sr-list-card sr-reveal">
          <div class="sr-list-thumb" style={`background:${getGrad(post.data.tags)}`}>
            {typeof post.data.ogImage === "string" ? (
              <img src={post.data.ogImage} alt="" loading="lazy" decoding="async" />
            ) : null}
          </div>
          <div class="sr-list-body">
            <span class="sr-kicker">{humanizeTag(post.data.tags[0] ?? "")}</span>
            <h2 class="sr-list-title">{post.data.title}</h2>
            <p class="sr-list-desc">{post.data.description}</p>
            <time class="sr-list-date" datetime={post.data.pubDatetime.toISOString()}>
              {fmtDate(post.data.pubDatetime)}
            </time>
          </div>
        </a>
      ))}
    </div>

    {page.lastPage > 1 && <Pagination {page} />}
  </main>
</Layout>
