---
import Layout from "@/layouts/Layout.astro";
import config from "@/config";
import { getWhatsAppUrl } from "@/utils/getWhatsAppUrl";

const whatsAppUrl = getWhatsAppUrl(config);
const title = "Sobre - Jocivane Brito e a Monumental Contabilidade";
const description = "Jocivane Brito é tributarista em Brasília-DF com mais de 10 anos de atuação em planejamento fiscal consultivo para PMEs, fornecedores do governo federal e holdings patrimoniais.";
---

<Layout title={`${title} | ${config.site.title}`} description={description}>

  <main class="about-page sr-wrap">

    <nav class="sr-crumb" aria-label="Breadcrumb" style="margin-bottom:56px">
      <a href="/">Início</a>
      <span class="sep" aria-hidden="true">›</span>
      <span style="color:var(--ink-2)">Sobre</span>
    </nav>

    <!-- ── HERO ── -->
    <section class="about-hero">

      <!-- Col 1: Foto editorial -->
      <div class="about-hero-img-wrap">
        <img
          src="/jocivane-brito-bw.jpg"
          alt="Jocivane Brito - Tributarista em Brasília-DF"
          class="about-hero-img"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Col 2: Identidade + CTA -->
      <div class="about-hero-copy">
        <h1 class="about-hero-title">Jocivane<br>Brito</h1>
        <p class="about-hero-sub">
          Tributarista com mais de 10 anos dedicados exclusivamente ao planejamento fiscal
          para empresas em Brasília. Não o contador que entrega obrigações. O que aparece
          quando a decisão custa caro.
        </p>
        <p class="about-hero-cred">CRC-DF · Tributarista · Contabilidade Consultiva</p>
        <a
          href={whatsAppUrl}
          target="_blank"
          rel="noopener"
          class="sr-btn about-hero-cta"
          onclick="if(typeof gtag!=='undefined'){gtag('event','generate_lead',{lead_source:'blog',lead_type:'about_hero_whatsapp'})}"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.117 1.523 5.847L0 24l6.342-1.493A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.374l-.357-.213-3.768.888.944-3.669-.235-.376A9.818 9.818 0 1112 21.818z"/></svg>
          Falar com Jocivane
        </a>
      </div>

      <!-- Col 3: Prova numérica editorial -->
      <aside class="about-proof-col" aria-label="Dados de atuação">
        <div class="about-proof-fig">
          <span class="about-proof-n">10+</span>
          <span class="about-proof-u">anos de atuação</span>
        </div>
        <div class="about-proof-fig">
          <span class="about-proof-n">DF</span>
          <span class="about-proof-u">foco Brasília</span>
        </div>
        <div class="about-proof-fig">
          <span class="about-proof-n">CRC</span>
          <span class="about-proof-u">registrado</span>
        </div>
        <div class="about-proof-sep"></div>
        <p class="about-proof-areas">
          Planejamento tributário · Fornecedores do governo federal · Holdings patrimoniais · Reforma Tributária 2026
        </p>
        <a
          href={whatsAppUrl}
          target="_blank"
          rel="noopener"
          class="about-proof-link"
          onclick="if(typeof gtag!=='undefined'){gtag('event','generate_lead',{lead_source:'blog',lead_type:'about_proof_link'})}"
        >
          Diagnóstico gratuito &rarr;
        </a>
      </aside>

    </section>

    <!-- ── QUEM É JOCIVANE ── -->
    <section class="about-section sr-reveal">
      <div class="about-section-grid">
        <h2 class="about-section-title">Quem é<br>Jocivane Brito</h2>
        <div class="about-section-body">
          <p>
            A maioria das empresas paga mais imposto do que deveria. Não por desonestidade do
            contador. Por falta de um olhar estratégico sobre a carga tributária. Jocivane Brito
            existe para preencher exatamente esse espaço.
          </p>
          <p>
            Formado em Ciências Contábeis e registrado no CRC-DF, atua na intersecção entre
            legislação tributária e realidade operacional das empresas em Brasília. Um contexto
            único no Brasil: alta concentração de fornecedores do setor público, retenções federais
            complexas, regimes diferenciados e agora a Reforma Tributária chegando.
          </p>
          <p>
            Cada análise começa pelos números reais da empresa. Não por planilhas genéricas.
            Qual o regime tributário atual? Qual o impacto de mudar? Existe crédito recuperável?
            Há risco em como os lucros estão sendo distribuídos? Essas são as perguntas que
            uma contabilidade consultiva responde.
          </p>
        </div>
      </div>

      <!-- Expertise: tipográfica, sem emojis -->
      <div class="about-expertise-list">
        <div class="about-el-item">
          <span class="about-el-area">Planejamento tributário</span>
          <p class="about-el-desc">Análise e migração entre Lucro Real, Lucro Presumido e Simples Nacional. Cada regime tem uma aritmética própria - a empresa que não faz o cálculo deixa dinheiro na mesa todo mês.</p>
        </div>
        <div class="about-el-item">
          <span class="about-el-area">Fornecedores do governo federal</span>
          <p class="about-el-desc">Retenções na fonte, SICAF, split payment da Reforma. Empresas que faturam para a União precisam de atenção específica - os erros aqui geram passivos que aparecem anos depois.</p>
        </div>
        <div class="about-el-item">
          <span class="about-el-area">Holdings patrimoniais</span>
          <p class="about-el-desc">Estruturação, sucessão e proteção de patrimônio empresarial via holding. Uma ferramenta poderosa quando bem desenhada, cara quando feita sem planejamento.</p>
        </div>
        <div class="about-el-item">
          <span class="about-el-area">Reforma Tributária 2026</span>
          <p class="about-el-desc">IBS, CBS e split payment chegam com impacto real no fluxo de caixa de quem fornece para o governo. As empresas que começaram a planejar agora chegam em 2027 sem surpresa.</p>
        </div>
      </div>
    </section>

    <!-- ── O QUE É ESTE BLOG ── -->
    <section class="about-section sr-reveal">
      <div class="about-section-grid">
        <h2 class="about-section-title">O que é<br>este blog</h2>
        <div class="about-section-body">
          <p>
            Existe uma versão do blog de contabilidade que todo escritório tem: conteúdo genérico,
            prazos de obrigações, notícias do governo com nenhuma interpretação prática. Não é isso.
          </p>
          <p>
            Este blog existe para o empresário que já recebeu respostas vagas do contador,
            que já pagou a guia sem entender o que estava pagando, que já tomou uma decisão
            de negócio sem saber o custo tributário dela. Cada artigo nasce de um caso real
            da carteira de clientes da Monumental. Com números. Sem teoria genérica.
          </p>

          <div class="about-audience-strip">
            <div class="about-aud-item">
              <span class="about-aud-label">Para quem</span>
              <strong>Empresário de PME em Brasília-DF</strong>
              <p>que quer reduzir carga tributária dentro da lei, sem surpresa no próximo exercício</p>
            </div>
            <div class="about-aud-item">
              <span class="about-aud-label">Para quem</span>
              <strong>Fornecedor do governo federal</strong>
              <p>que precisa entender retenções, SICAF e como o split payment vai impactar seu caixa</p>
            </div>
            <div class="about-aud-item">
              <span class="about-aud-label">Para quem</span>
              <strong>Sócio e gestor financeiro</strong>
              <p>preparando a empresa para a Reforma Tributária 2026 com antecedência suficiente para agir</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── A MONUMENTAL ── -->
    <section class="about-section sr-reveal">
      <div class="about-section-grid">
        <h2 class="about-section-title">A Monumental Contabilidade</h2>
        <div class="about-section-body">
          <p>
            A Monumental Contabilidade não é um escritório de obrigações. Escritórios de obrigações
            entregam o que a Receita Federal pede. Fazem isso bem. Mas param aí.
          </p>
          <p>
            A Monumental começa onde a contabilidade padrão termina. Depois que as obrigações estão
            cumpridas, existe uma pergunta que a maioria dos escritórios não faz: esse regime tributário
            ainda faz sentido para o tamanho que sua empresa tem hoje? Essa decisão tomada seis meses
            atrás, qual foi o custo tributário dela? Essa distribuição de lucros está dentro da lei?
          </p>
          <p>
            Atuação exclusiva em Brasília-DF. Foco nas particularidades do ecossistema tributário do
            Distrito Federal, dos fornecedores do setor público e das empresas que operam no contexto
            de um dos maiores mercados institucionais do Brasil.
          </p>
        </div>
      </div>
    </section>

    <!-- ── CTA FINAL ── -->
    <section class="about-cta-section sr-reveal">
      <div class="about-cta-inner">
        <img
          src="/jocivane-brito.jpg"
          alt="Jocivane Brito"
          class="about-cta-photo"
          loading="lazy"
          decoding="async"
        />
        <div class="about-cta-copy">
          <h2 class="about-cta-title">A primeira conversa não custa nada.</h2>
          <p>
            Mas pode revelar o que sua empresa está pagando a mais. Jocivane Brito atende
            diretamente. Traga seus números. A análise é gratuita, o diagnóstico é seu.
          </p>
          <p class="about-cta-meta">
            Monumental Contabilidade · Brasília-DF · <a href="https://monumentalcontabilidade.com.br">monumentalcontabilidade.com.br</a>
          </p>
          <a
            href={whatsAppUrl}
            target="_blank"
            rel="noopener"
            class="sr-btn about-cta-btn"
            onclick="if(typeof gtag!=='undefined'){gtag('event','generate_lead',{lead_source:'blog',lead_type:'about_final_whatsapp'})}"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.117 1.523 5.847L0 24l6.342-1.493A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.374l-.357-.213-3.768.888.944-3.669-.235-.376A9.818 9.818 0 1112 21.818z"/></svg>
            Falar com Jocivane pelo WhatsApp
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
.about-page {
  max-width: none;
  padding-bottom: 120px;
}

/* ═══════════════════════════════════
   HERO
════════════════════════════════════ */
.about-hero {
  display: grid;
  grid-template-columns: 240px 1fr 260px;
  gap: 52px;
  align-items: start;
  margin-bottom: 88px;
}
@media (max-width: 960px) {
  .about-hero { grid-template-columns: 220px 1fr; }
  .about-proof-col { display: none; }
}
@media (max-width: 680px) {
  .about-hero { grid-template-columns: 1fr; gap: 28px; }
}

.about-hero-img-wrap {
  border-radius: 4px;
  overflow: hidden;
  aspect-ratio: 3/4;
  background: var(--navy, #282e69);
}
.about-hero-img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center top;
}

.about-hero-title {
  font-family: var(--font-display);
  font-size: clamp(44px, 6vw, 72px);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 0.96;
  color: var(--ink-1);
  margin: 0 0 24px;
}
.about-hero-sub {
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink-2);
  max-width: 44ch;
  margin: 0 0 20px;
}
.about-hero-cred {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--gold, #cfaf75);
  margin: 0 0 28px;
}
.about-hero-cta {
  display: inline-flex;
  gap: 8px;
  align-items: center;
}

/* ── Proof col (editorial) ── */
.about-proof-col {
  border-left: 1px solid rgba(255,255,255,.1);
  padding-left: 32px;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 88px;
}
.about-proof-fig {
  padding: 20px 0;
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.about-proof-fig:first-child { padding-top: 4px; }
.about-proof-n {
  display: block;
  font-family: var(--font-display);
  font-size: 48px;
  font-weight: 700;
  color: var(--ink-1);
  letter-spacing: -0.05em;
  line-height: 1;
}
.about-proof-u {
  display: block;
  font-family: var(--font-mono);
  font-size: 9.5px;
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: .12em;
  margin-top: 4px;
}
.about-proof-sep {
  height: 1px;
  background: rgba(255,255,255,.07);
  margin: 24px 0;
}
.about-proof-areas {
  font-size: 12px;
  color: var(--ink-3);
  line-height: 1.65;
  margin: 0 0 18px;
}
.about-proof-link {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--gold, #cfaf75);
  text-decoration: none;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.about-proof-link:hover { opacity: .7; }

/* ═══════════════════════════════════
   SECTIONS
════════════════════════════════════ */
.about-section {
  border-top: 1px solid rgba(255,255,255,.07);
  padding: 64px 0 72px;
}
.about-section-grid {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 52px;
  align-items: start;
}
@media (max-width: 680px) {
  .about-section-grid { grid-template-columns: 1fr; gap: 20px; }
}
.about-section-title {
  font-family: var(--font-display);
  font-size: clamp(20px, 2.5vw, 28px);
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 1.1;
  color: var(--ink-1);
  margin: 0;
  position: sticky;
  top: 88px;
}
.about-section-body {
  color: var(--ink-2);
  font-size: 16px;
  line-height: 1.74;
}
.about-section-body p { margin: 0 0 16px; }
.about-section-body p:last-child { margin-bottom: 0; }
.about-section-body strong { color: var(--ink-1); font-weight: 600; }

/* ── Expertise list (tipográfica, sem emojis) ── */
.about-expertise-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid rgba(255,255,255,.07);
  margin-top: 48px;
}
@media (max-width: 680px) {
  .about-expertise-list { grid-template-columns: 1fr; }
}
.about-el-item {
  padding: 28px 0;
  border-bottom: 1px solid rgba(255,255,255,.05);
}
.about-el-item:nth-child(odd) {
  padding-right: 40px;
  border-right: 1px solid rgba(255,255,255,.05);
}
.about-el-item:nth-child(even) {
  padding-left: 40px;
}
@media (max-width: 680px) {
  .about-el-item:nth-child(odd) { padding-right: 0; border-right: none; }
  .about-el-item:nth-child(even) { padding-left: 0; }
}
.about-el-area {
  display: block;
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  color: var(--ink-1);
  margin-bottom: 8px;
}
.about-el-desc {
  font-size: 13.5px;
  color: var(--ink-3);
  line-height: 1.65;
  margin: 0;
}

/* ── Audience strip ── */
.about-audience-strip {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 0;
  border-top: 1px solid rgba(255,255,255,.07);
  margin-top: 36px;
}
@media (max-width: 760px) {
  .about-audience-strip { grid-template-columns: 1fr; }
}
.about-aud-item {
  padding: 24px 0;
  border-bottom: 1px solid rgba(255,255,255,.05);
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.about-aud-item:not(:last-child) {
  padding-right: 28px;
  border-right: 1px solid rgba(255,255,255,.05);
}
.about-aud-item:not(:first-child) {
  padding-left: 28px;
}
@media (max-width: 760px) {
  .about-aud-item:not(:last-child) { padding-right: 0; border-right: none; }
  .about-aud-item:not(:first-child) { padding-left: 0; }
}
.about-aud-label {
  font-family: var(--font-mono);
  font-size: 9.5px;
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: .1em;
}
.about-aud-item strong {
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  color: var(--ink-1);
}
.about-aud-item p {
  font-size: 12.5px;
  color: var(--ink-3);
  line-height: 1.55;
  margin: 0;
}

/* ═══════════════════════════════════
   CTA FINAL
════════════════════════════════════ */
.about-cta-section {
  border-top: 1px solid rgba(255,255,255,.07);
  padding: 64px 0 0;
}
.about-cta-inner {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 40px;
  align-items: start;
}
@media (max-width: 480px) {
  .about-cta-inner { grid-template-columns: 1fr; gap: 24px; }
}
.about-cta-photo {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  object-position: center top;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,.1);
}
.about-cta-title {
  font-family: var(--font-display);
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 1.1;
  color: var(--ink-1);
  margin: 0 0 16px;
}
.about-cta-copy p {
  font-size: 15.5px;
  color: var(--ink-2);
  line-height: 1.65;
  margin: 0 0 12px;
  max-width: 52ch;
}
.about-cta-meta {
  font-size: 13px;
  color: var(--ink-3) !important;
}
.about-cta-meta a {
  color: var(--gold, #cfaf75);
}
.about-cta-btn {
  margin-top: 24px;
  display: inline-flex;
  gap: 8px;
  align-items: center;
  font-size: 15px;
  padding: 14px 28px;
}
</style>
