---
import Layout from "@/layouts/Layout.astro";
import config from "@/config";
import { getWhatsAppUrl } from "@/utils/getWhatsAppUrl";

const whatsAppUrl = getWhatsAppUrl(config);
const title = "Sobre a Alínea Finanças — BPO Financeiro em Brasília-DF";
const description = "A Alínea Finanças oferece BPO financeiro e contabilidade consultiva para empresas em Brasília-DF. Gestão financeira terceirizada, planejamento tributário e suporte para fornecedores do governo federal.";
---

<Layout title={`${title} | ${config.site.title}`} description={description}>

  <main class="about-page sr-wrap">

    <nav class="sr-crumb" aria-label="Breadcrumb" style="margin-bottom:56px">
      <a href="/">Início</a>
      <span class="sep" aria-hidden="true">›</span>
      <span style="color:var(--ink-2)">Sobre</span>
    </nav>

    <!-- ── HERO ── -->
    <section class="about-hero">

      <!-- Col 1: Logo editorial -->
      <div class="about-hero-img-wrap">
        <img
          src="/logo-alinea.png"
          alt="Alínea Finanças — BPO Financeiro em Brasília-DF"
          class="about-hero-logo"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Col 2: Identidade + CTA -->
      <div class="about-hero-copy">
        <h1 class="about-hero-title">Alínea<br>Finanças</h1>
        <p class="about-hero-sub">
          BPO financeiro e contabilidade consultiva para empresas em Brasília-DF.
          Não o contador que entrega obrigações. O parceiro que aparece quando a
          decisão financeira custa caro.
        </p>
        <p class="about-hero-cred">BPO Financeiro · Contabilidade Consultiva · Brasília-DF</p>
        <a
          href={whatsAppUrl}
          target="_blank"
          rel="noopener"
          class="sr-btn about-hero-cta"
          onclick="if(typeof gtag!=='undefined'){gtag('event','generate_lead',{lead_source:'blog',lead_type:'about_hero_whatsapp'})}"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.117 1.523 5.847L0 24l6.342-1.493A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.374l-.357-.213-3.768.888.944-3.669-.235-.376A9.818 9.818 0 1112 21.818z"/></svg>
          Falar com a Alínea
        </a>
      </div>

      <!-- Col 3: Prova numérica editorial -->
      <aside class="about-proof-col" aria-label="Dados de atuação">
        <div class="about-proof-fig">
          <span class="about-proof-n">DF</span>
          <span class="about-proof-u">foco Brasília</span>
        </div>
        <div class="about-proof-fig">
          <span class="about-proof-n">360°</span>
          <span class="about-proof-u">BPO financeiro</span>
        </div>
        <div class="about-proof-fig">
          <span class="about-proof-n">CRC</span>
          <span class="about-proof-u">registrado</span>
        </div>
        <div class="about-proof-sep"></div>
        <p class="about-proof-areas">
          BPO financeiro · Gestão financeira · Planejamento tributário · Reforma Tributária 2026 · Fornecedores do governo federal
        </p>
        <a
          href={whatsAppUrl}
          target="_blank"
          rel="noopener"
          class="about-proof-link"
          onclick="if(typeof gtag!=='undefined'){gtag('event','generate_lead',{lead_source:'blog',lead_type:'about_proof_link'})}"
        >
          Diagnóstico gratuito &rarr;
        </a>
      </aside>

    </section>

    <!-- ── QUEM É A ALÍNEA ── -->
    <section class="about-section sr-reveal">
      <div class="about-section-grid">
        <h2 class="about-section-title">Quem é<br>a Alínea Finanças</h2>
        <div class="about-section-body">
          <p>
            A maioria das empresas trata financeiro e contabilidade como obrigação. Paga o contador,
            recebe as guias, assina o balanço. E não sabe ao certo se está pagando mais imposto do que
            deveria — ou se a operação financeira consome mais tempo e custo do que vale.
          </p>
          <p>
            A Alínea Finanças existe para preencher exatamente esse espaço. Somos especialistas em
            BPO financeiro e contabilidade consultiva para PMEs em Brasília-DF — um contexto único
            no Brasil: alta concentração de fornecedores do setor público, retenções federais complexas,
            regimes diferenciados e agora a Reforma Tributária chegando em velocidade real.
          </p>
          <p>
            Cada análise começa pelos números reais da empresa. Qual o regime tributário atual? O custo
            real de terceirizar o financeiro? Existe crédito tributário recuperável? Como o split payment
            vai afetar o seu fluxo de caixa? Essas são as perguntas que uma contabilidade consultiva
            responde — e que um escritório de obrigações geralmente não pergunta.
          </p>
        </div>
      </div>

      <!-- Expertise: tipográfica, sem emojis -->
      <div class="about-expertise-list">
        <div class="about-el-item">
          <span class="about-el-area">BPO financeiro</span>
          <p class="about-el-desc">Contas a pagar e receber, conciliação bancária, DRE mensal e fluxo de caixa gerenciados pela Alínea. Você foca no negócio; a gente cuida dos números com precisão e pontualidade.</p>
        </div>
        <div class="about-el-item">
          <span class="about-el-area">Planejamento tributário</span>
          <p class="about-el-desc">Simples Nacional, Lucro Presumido, Lucro Real. A maioria das empresas entrou num regime e nunca mais reviu. Quando o faturamento muda, o regime certo muda junto. A Alínea faz essa análise com os seus números reais.</p>
        </div>
        <div class="about-el-item">
          <span class="about-el-area">Fornecedores do governo federal</span>
          <p class="about-el-desc">Retenções na fonte, SICAF, split payment da Reforma. Empresas que faturam para a União precisam de atenção específica — os erros aqui geram passivos que aparecem anos depois.</p>
        </div>
        <div class="about-el-item">
          <span class="about-el-area">Reforma Tributária 2026</span>
          <p class="about-el-desc">IBS, CBS e split payment chegam com impacto real no fluxo de caixa de quem fornece para o governo. As empresas que começaram a planejar agora chegam em 2027 sem surpresa no caixa.</p>
        </div>
      </div>
    </section>

    <!-- ── O QUE É ESTE BLOG ── -->
    <section class="about-section sr-reveal">
      <div class="about-section-grid">
        <h2 class="about-section-title">O que é<br>este blog</h2>
        <div class="about-section-body">
          <p>
            Existe uma versão do blog de contabilidade que todo escritório tem: conteúdo genérico,
            prazos de obrigações, notícias do governo com nenhuma interpretação prática. Não é isso.
          </p>
          <p>
            Este blog existe para o empresário que já recebeu respostas vagas do contador,
            que já pagou a guia sem entender o que estava pagando, que já tomou uma decisão
            de negócio sem saber o custo tributário dela. Cada artigo nasce de casos reais
            da carteira da Alínea. Com números. Sem teoria genérica.
          </p>

          <div class="about-audience-strip">
            <div class="about-aud-item">
              <span class="about-aud-label">Para quem</span>
              <strong>Empresário de PME em Brasília-DF</strong>
              <p>que quer gestão financeira profissional e redução de carga tributária dentro da lei</p>
            </div>
            <div class="about-aud-item">
              <span class="about-aud-label">Para quem</span>
              <strong>Fornecedor do governo federal</strong>
              <p>que precisa entender retenções, SICAF e como o split payment vai impactar seu caixa</p>
            </div>
            <div class="about-aud-item">
              <span class="about-aud-label">Para quem</span>
              <strong>Sócio e gestor financeiro</strong>
              <p>preparando a empresa para a Reforma Tributária 2026 com antecedência suficiente para agir</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── A ALÍNEA ── -->
    <section class="about-section sr-reveal">
      <div class="about-section-grid">
        <h2 class="about-section-title">A Alínea Finanças</h2>
        <div class="about-section-body">
          <p>
            A Alínea Finanças não é um escritório de obrigações. Escritórios de obrigações
            entregam o que a Receita Federal pede. Fazem isso bem. Mas param aí.
          </p>
          <p>
            A Alínea começa onde a contabilidade padrão termina. Depois que as obrigações estão
            cumpridas, existe uma pergunta que a maioria dos escritórios não faz: esse regime tributário
            ainda faz sentido para o tamanho que sua empresa tem hoje? Essa decisão tomada seis meses
            atrás, qual foi o custo tributário dela? O financeiro da empresa está consumindo horas do
            dono que deveriam estar no negócio?
          </p>
          <p>
            Atuação exclusiva em Brasília-DF. Foco nas particularidades do ecossistema tributário e
            financeiro do Distrito Federal, dos fornecedores do setor público e das empresas que operam
            no contexto de um dos maiores mercados institucionais do Brasil.
          </p>
        </div>
      </div>
    </section>

    <!-- ── CTA FINAL ── -->
    <section class="about-cta-section sr-reveal">
      <div class="about-cta-inner">
        <!-- Col esquerda: logo + copy + btn -->
        <div class="about-cta-copy">
          <img src="/logo-alinea.png" alt="Alínea Finanças" class="about-cta-logo" />
          <h2 class="about-cta-title">A primeira conversa não custa nada.</h2>
          <p class="about-cta-body">
            Mas pode revelar o que sua empresa está pagando a mais — em impostos ou em operação
            financeira ineficiente. A Alínea atende diretamente. Traga seus números. O diagnóstico
            é gratuito e o resultado é seu.
          </p>
          <div class="about-cta-row">
            <a
              href={whatsAppUrl}
              target="_blank"
              rel="noopener"
              class="sr-btn about-cta-btn"
              onclick="if(typeof gtag!=='undefined'){gtag('event','generate_lead',{lead_source:'blog',lead_type:'about_final_whatsapp'})}"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.117 1.523 5.847L0 24l6.342-1.493A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.374l-.357-.213-3.768.888.944-3.669-.235-.376A9.818 9.818 0 1112 21.818z"/></svg>
              Falar com a Alínea pelo WhatsApp
            </a>
          </div>
          <span class="about-cta-attr">Alínea Finanças · BPO Financeiro · Brasília-DF</span>
        </div>
        <!-- Col direita: logo editorial -->
        <div class="about-cta-photo-wrap">
          <img
            src="/logo-alinea.png"
            alt="Alínea Finanças"
            class="about-cta-photo"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
.about-page {
  max-width: none;
  padding-bottom: 120px;
}

/* ═══════════════════════════════════
   HERO
════════════════════════════════════ */
.about-hero {
  display: grid;
  grid-template-columns: 240px 1fr 260px;
  gap: 52px;
  align-items: start;
  margin-bottom: 88px;
}
@media (max-width: 960px) {
  .about-hero { grid-template-columns: 220px 1fr; }
  .about-proof-col { display: none; }
}
@media (max-width: 680px) {
  .about-hero { grid-template-columns: 1fr; gap: 28px; }
}

.about-hero-img-wrap {
  border-radius: 4px;
  overflow: hidden;
  padding: 32px;
  background: var(--navy, #05364c);
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 3/4;
}
.about-hero-logo {
  width: 100%;
  max-width: 160px;
  object-fit: contain;
}

.about-hero-title {
  font-family: var(--font-display);
  font-size: clamp(44px, 6vw, 72px);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 0.96;
  color: var(--ink-1);
  margin: 0 0 24px;
}
.about-hero-sub {
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink-2);
  max-width: 44ch;
  margin: 0 0 20px;
}
.about-hero-cred {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--gold, #bd772f);
  margin: 0 0 28px;
}
.about-hero-cta {
  display: inline-flex;
  gap: 8px;
  align-items: center;
}

/* ── Proof col (editorial) ── */
.about-proof-col {
  border-left: 1px solid rgba(255,255,255,.1);
  padding-left: 32px;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 88px;
}
.about-proof-fig {
  padding: 20px 0;
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.about-proof-fig:first-child { padding-top: 4px; }
.about-proof-n {
  display: block;
  font-family: var(--font-display);
  font-size: 48px;
  font-weight: 700;
  color: var(--ink-1);
  letter-spacing: -0.05em;
  line-height: 1;
}
.about-proof-u {
  display: block;
  font-family: var(--font-mono);
  font-size: 9.5px;
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: .12em;
  margin-top: 4px;
}
.about-proof-sep {
  height: 1px;
  background: rgba(255,255,255,.07);
  margin: 24px 0;
}
.about-proof-areas {
  font-size: 12px;
  color: var(--ink-3);
  line-height: 1.65;
  margin: 0 0 18px;
}
.about-proof-link {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--gold, #bd772f);
  text-decoration: none;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.about-proof-link:hover { opacity: .7; }

/* ═══════════════════════════════════
   SECTIONS
════════════════════════════════════ */
.about-section {
  border-top: 1px solid rgba(255,255,255,.07);
  padding: 64px 0 72px;
}
.about-section-grid {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 52px;
  align-items: start;
}
@media (max-width: 680px) {
  .about-section-grid { grid-template-columns: 1fr; gap: 20px; }
}
.about-section-title {
  font-family: var(--font-display);
  font-size: clamp(20px, 2.5vw, 28px);
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 1.1;
  color: var(--ink-1);
  margin: 0;
  position: sticky;
  top: 88px;
}
.about-section-body {
  color: var(--ink-2);
  font-size: 16px;
  line-height: 1.74;
}
.about-section-body p { margin: 0 0 16px; }
.about-section-body p:last-child { margin-bottom: 0; }
.about-section-body strong { color: var(--ink-1); font-weight: 600; }

/* ── Expertise list (tipográfica, sem emojis) ── */
.about-expertise-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid rgba(255,255,255,.07);
  margin-top: 48px;
}
@media (max-width: 680px) {
  .about-expertise-list { grid-template-columns: 1fr; }
}
.about-el-item {
  padding: 28px 0;
  border-bottom: 1px solid rgba(255,255,255,.05);
}
.about-el-item:nth-child(odd) {
  padding-right: 40px;
  border-right: 1px solid rgba(255,255,255,.05);
}
.about-el-item:nth-child(even) {
  padding-left: 40px;
}
@media (max-width: 680px) {
  .about-el-item:nth-child(odd) { padding-right: 0; border-right: none; }
  .about-el-item:nth-child(even) { padding-left: 0; }
}
.about-el-area {
  display: block;
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  color: var(--ink-1);
  margin-bottom: 8px;
}
.about-el-desc {
  font-size: 13.5px;
  color: var(--ink-3);
  line-height: 1.65;
  margin: 0;
}

/* ── Audience strip ── */
.about-audience-strip {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 0;
  border-top: 1px solid rgba(255,255,255,.07);
  margin-top: 36px;
}
@media (max-width: 760px) {
  .about-audience-strip { grid-template-columns: 1fr; }
}
.about-aud-item {
  padding: 24px 0;
  border-bottom: 1px solid rgba(255,255,255,.05);
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.about-aud-item:not(:last-child) {
  padding-right: 28px;
  border-right: 1px solid rgba(255,255,255,.05);
}
.about-aud-item:not(:first-child) {
  padding-left: 28px;
}
@media (max-width: 760px) {
  .about-aud-item:not(:last-child) { padding-right: 0; border-right: none; }
  .about-aud-item:not(:first-child) { padding-left: 0; }
}
.about-aud-label {
  font-family: var(--font-mono);
  font-size: 9.5px;
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: .1em;
}
.about-aud-item strong {
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  color: var(--ink-1);
}
.about-aud-item p {
  font-size: 12.5px;
  color: var(--ink-3);
  line-height: 1.55;
  margin: 0;
}

/* ═══════════════════════════════════
   CTA FINAL
════════════════════════════════════ */
.about-cta-section {
  border-top: 1px solid rgba(255,255,255,.07);
  padding: 72px 0 0;
}
.about-cta-inner {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 64px;
  align-items: end;
}
@media (max-width: 860px) {
  .about-cta-inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .about-cta-photo-wrap { order: -1; max-width: 280px; }
}
.about-cta-logo {
  height: 36px;
  width: auto;
  margin-bottom: 32px;
  display: block;
  opacity: .85;
}
.about-cta-title {
  font-family: var(--font-display);
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.05;
  color: var(--ink-1);
  margin: 0 0 20px;
}
.about-cta-body {
  font-size: 16px;
  color: var(--ink-2);
  line-height: 1.7;
  margin: 0 0 28px;
  max-width: 52ch;
}
.about-cta-row {
  margin-bottom: 20px;
}
.about-cta-btn {
  display: inline-flex;
  gap: 8px;
  align-items: center;
  font-size: 15px;
  padding: 14px 28px;
}
.about-cta-attr {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: .1em;
  display: block;
}
.about-cta-photo-wrap {
  padding: 32px;
  background: var(--navy, #05364c);
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.about-cta-photo {
  width: 100%;
  max-width: 200px;
  object-fit: contain;
  display: block;
}
</style>
